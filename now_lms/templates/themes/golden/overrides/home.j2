<!doctype html>
<html lang="es">
    {% from 'macros/blog_section.j2' import render_blog_section %} {% set current_theme = current_theme() %}{% set site_config
    = config() %}
    <head>
        {{ current_theme.headertags() }} {{ current_theme.local_style() }}
        <title>{{ site_config.titulo_html or "NOW - Learning Management System" }}</title>

    </head>
    <body>
        {{ current_theme.navbar() }}

        <!-- Hero Section -->
        <section class="hero-section golden-hero py-5">
            <div class="golden-rays" aria-hidden="true"></div>
            <div class="golden-sparks" aria-hidden="true"><span>✦</span><span>✦</span><span>✦</span><span>✦</span><span>✦</span><span>✦</span></div>
            <div class="container position-relative">
                <div class="row align-items-center">
                    <div class="col-12 col-md-7 col-lg-7 order-2 order-md-1 text-white">
                        <div class="hero-content">
                            <p class="golden-kicker mb-3">NOW · {{ _('Brilla con tu potencial') }}</p>
                            <h1 class="display-4 fw-bold mb-4">
                                {{ _('Aprende con') }}
                                <span class="golden-script">{{ _('confianza') }}</span>
                            </h1>
                            <p class="lead mb-4 golden-hero-copy">
                                {% if site_config.hero and site_config.hero != "" %} {{ site_config.hero }} {% else %} {{
                                _('Cursos dinámicos, prácticos y divertidos — Clases online en vivo y material interactivo.')
                                }} {% endif %}
                            </p>
                            <div class="d-flex gap-3 flex-wrap justify-content-center justify-content-md-start">
                                {% if not current_user.is_authenticated %} {% if is_contact_enabled() %}
                                <a
                                    href="{{ url_for('static_pages.contact') }}"
                                    class="btn btn-golden-dark btn-lg px-4 py-2"
                                >
                                    <strong>{{ _('Reserva tu clase gratis') }}</strong>
                                </a>
                                {% else %}
                                <a
                                    href="{{ url_for('user.crear_cuenta') }}"
                                    class="btn btn-golden-dark btn-lg px-4 py-2"
                                >
                                    <strong>{{ _('Reserva tu clase gratis') }}</strong>
                                </a>
                                {% endif %}
                                <a
                                    href="{{ url_for('course.lista_cursos', page=1) }}"
                                    class="btn btn-golden-outline btn-lg px-4 py-2"
                                >
                                    {{ _('Ver cursos') }}
                                </a>
                                {% else %}
                                <a
                                    href="{{ url_for('home.panel') }}"
                                    class="btn btn-golden-dark btn-lg px-4 py-2"
                                >
                                    <strong>{{ _('Mi Panel') }}</strong>
                                </a>
                                <a
                                    href="{{ url_for('course.lista_cursos', page=1) }}"
                                    class="btn btn-golden-outline btn-lg px-4 py-2"
                                >
                                    {{ _('Ver cursos') }}
                                </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-5 col-lg-5 order-1 order-md-2 mb-4 mb-md-0 text-center">
                        <div class="hero-visual">
                            <div class="golden-medallion">
                                <span class="golden-medallion-mark">✦</span>
                                <span class="golden-medallion-title">{{ _('Tu momento') }}</span>
                                <span class="golden-medallion-subtitle">{{ _('empieza hoy') }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <main style="max-width: 1100px; margin: 0 auto; padding: 0 1rem">
            <!-- Contenido de cursos y características -->
            {% if site_config.enable_feature_section %}
            <section
                style="
                    background: #fff;
                    padding: 32px;
                    border-radius: 12px;
                    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
                    margin-bottom: 2rem;
                    margin-top: 2rem;
                "
            >
                <div class="row">
                    <div class="col-12 text-center mb-5">
                        <h2 class="display-6 fw-bold mb-4" style="color: #141411">{{ _('Descubre Nuestros Cursos') }}</h2>
                        <p class="lead" style="color: #5a5a54">
                            {{ _('Explora una nueva forma de aprender con nuestra plataforma educativa moderna y eficiente.')
                            }}
                        </p>
                    </div>
                </div>

                <!-- Features Section -->
                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <div class="feature-card h-100">
                            <div class="feature-icon mb-3">
                                <span style="color: #141411; font-size: 1.5rem">🎯</span>
                            </div>
                            <h4 class="mb-3" style="color: #141411">{{ _('Cursos Especializados') }}</h4>
                            <p style="line-height: 1.6; color: #5a5a54">
                                {{ _('Accede a una amplia variedad de cursos diseñados por expertos en cada área de
                                conocimiento.') }}
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card h-100">
                            <div class="feature-icon mb-3">
                                <span style="color: #141411; font-size: 1.5rem">👥</span>
                            </div>
                            <h4 class="mb-3" style="color: #141411">{{ _('Comunidad Activa') }}</h4>
                            <p style="line-height: 1.6; color: #5a5a54">
                                {{ _('Únete a una comunidad de estudiantes y profesionales que comparten tus intereses y
                                objetivos.') }}
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card h-100">
                            <div class="feature-icon mb-3">
                                <span style="color: #141411; font-size: 1.5rem">🏆</span>
                            </div>
                            <h4 class="mb-3" style="color: #141411">{{ _('Certificaciones') }}</h4>
                            <p style="line-height: 1.6; color: #5a5a54">
                                {{ _('Obtén certificaciones reconocidas que validen tu conocimiento y impulsen tu carrera
                                profesional.') }}
                            </p>
                        </div>
                    </div>
                </div>
                {% endif %}

                <!-- Featured Courses Section -->
                <div class="row"><br /></div>
                {% if cursos and cursos.total > 0 %}
                <div class="row">
                    <div class="col-12 text-center mb-4">
                        <h3 class="fw-bold mb-4" style="color: #141411">{{ _('Cursos Destacados') }}</h3>
                    </div>
                </div>
                <div class="row row-cols-1 row-cols-sm-2 g-4 mb-4">
                    {% for curso in cursos.items[:4] %}
                    <div class="col">
                        <div class="card-golden h-100">
                            {% if curso.portada and course_logo(curso.codigo) %}
                            <img
                                src="{{ url_for('static', filename='/files/public/images/' + curso.codigo + '/' + course_logo(curso.codigo)) }}"
                                alt="{{ curso.nombre }}"
                                class="card-img-top"
                                style="height: 200px; object-fit: cover; border-radius: 12px 12px 0 0"
                            />
                            {% else %}
                            <div
                                class="card-img-top d-flex align-items-center justify-content-center"
                                style="
                                    height: 200px;
                                    background: linear-gradient(135deg, #f0b744 0%, #f49640 100%);
                                    border-radius: 12px 12px 0 0;
                                    color: #141411;
                                "
                            >
                                <div class="text-center">
                                    <div style="font-size: 2rem; margin-bottom: 0.5rem">📚</div>
                                    <div style="font-size: 1rem; font-weight: 600">{{ curso.nombre }}</div>
                                </div>
                            </div>
                            {% endif %}

                            <div class="card-body d-flex flex-column" style="padding: 1.5rem">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0" style="color: #141411">{{ curso.nombre }}</h5>
                                    <div class="d-flex align-items-center gap-2">
                                        {% if not curso.precio %}
                                        <span class="badge badge-golden">{{ _('Gratis') }}</span>
                                        {% endif %} {% if curso.nivel == 0 %}
                                        <span class="badge bg-secondary" title="Nivel Introductorio">{{ _('Intro') }}</span>
                                        {% elif curso.nivel == 1 %}
                                        <span class="badge bg-primary" title="Nivel Principiante"
                                            >{{ _('Principiante') }}</span
                                        >
                                        {% elif curso.nivel == 2 %}
                                        <span class="badge bg-warning" title="Nivel Intermedio">{{ _('Intermedio') }}</span>
                                        {% elif curso.nivel == 3 %}
                                        <span class="badge bg-danger" title="Nivel Avanzado">{{ _('Avanzado') }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <p class="card-text flex-grow-1" style="color: #5a5a54">
                                    {{ curso.descripcion_corta | truncate(100) }}
                                </p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <a
                                        href="{{ url_for('course.curso', course_code=curso.codigo) }}"
                                        class="btn btn-golden-secondary btn-sm"
                                        >{{ _('Ver Curso') }}</a
                                    >
                                    <div class="text-end">
                                        {% if curso.duracion %}
                                        <small class="text-muted d-block">{{ curso.duracion }} mins</small>
                                        {% endif %} {% if curso.precio %}
                                        <small class="fw-bold" style="color: #141411"
                                            >{{ curso.precio | float }} {{ site_config.moneda }}</small
                                        >
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <div class="text-center">
                    <a href="{{ url_for('course.lista_cursos', page=1) }}" class="btn btn-golden-primary btn-lg px-4 py-2">
                        {{ _('Ver Todos los Cursos') }}
                    </a>
                </div>
                {% endif %}
            </section>

            <!-- Call to Action Section -->
            <section
                style="
                    background: #fff;
                    padding: 2rem;
                    border-radius: 12px;
                    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
                    margin-bottom: 2rem;
                "
            >
                <div class="text-center">
                    {% if not current_user.is_authenticated %}
                    <h3 class="mb-4" style="color: #141411">{{ _('¿Listo para Comenzar?') }}</h3>
                    <p class="lead mb-4" style="color: #5a5a54">
                        {{ _('Únete a nuestra plataforma educativa y comienza tu viaje de aprendizaje hoy mismo.') }}
                    </p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        {% if is_contact_enabled() %}
                        <a href="{{ url_for('static_pages.contact') }}" class="cta-primary"> {{ _('Contáctanos') }} </a>
                        {% endif %}
                        <a href="{{ url_for('user.crear_cuenta') }}" class="cta-secondary"> {{ _('Registrarse Gratis') }} </a>
                    </div>
                    {% else %}
                    <h3 class="mb-4" style="color: #141411">{{ _('Bienvenido de vuelta') }}, {{ current_user.nombre }}</h3>
                    <p class="lead mb-4" style="color: #5a5a54">
                        {{ _('Continúa tu viaje de aprendizaje y explora nuevas oportunidades educativas.') }}
                    </p>
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a href="{{ url_for('home.panel') }}" class="cta-primary"> {{ _('Ir a Mi Panel') }} </a>
                        <a href="{{ url_for('course.lista_cursos', page=1) }}" class="cta-secondary">
                            {{ _('Explorar Cursos') }}
                        </a>
                        {% if is_contact_enabled() %}
                        <a href="{{ url_for('static_pages.contact') }}" class="cta-secondary"> {{ _('Contáctanos') }} </a>
                        {% endif %}
                    </div>
                    {% endif %}
                </div>
            </section>

            <!-- Blog Posts Section -->
            {% if show_blog_posts %} {{ render_blog_section(latest_blog_posts, '#fafaf8') }} {% endif %}
        </main>

        {{ current_theme.footer() }} {{ current_theme.jslibs() }}
    </body>
</html>

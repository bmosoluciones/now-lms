{% set current_theme = current_theme() %}
<!doctype html>
<html lang="{{ current_locale() }}">
    {% set config = config() %}
    <head>
        {{ current_theme.headertags() }}
        <title>{{ _('Recursos Disponibles') }}</title>
        {{ current_theme.local_style() }}
    </head>
    <body>
        {{ current_theme.navbar() }}
        <main>
            <div class="container py-4">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="{{ url_for('home.pagina_de_inicio') }}">{{ _('Inicio') }}</a>
                        </li>
                        <li class="breadcrumb-item active">{{ _('Recursos disponibles') }}</li>
                    </ol>
                </nav>
                <h1>{{ _('Recursos Disponibles') }}</h1>
                {{ current_theme.rendizar_paginacion(consulta=cursos, vista="lista_recursos") }}
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
                    {% for curso in cursos.items %}
                    <div class="col">
                        <div class="card shadow-sm">
                            {% if curso.logo %}
                            <img src="{{ url_for('static', filename='/files/public/images/resources_files/' + curso.codigo + '.jpg') }}" alt="{{ curso.nombre }}" width="100%" height="200" />
                            {% endif %}
                            <div class="card-body">
                                <h5 class="card-title">{{ curso.nombre }}</h5>
                                <p class="card-text">{{ curso.descripcion_corta|truncate(100) }}</p>
                                <a href="{{ url_for('resource.vista_recurso', resource_code=curso.codigo) }}" class="btn btn-sm btn-primary">{{ _('Ver') }}</a>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </main>
        {{ current_theme.footer() }}
        {{ current_theme.jslibs() }}
    </body>
</html>

{% set current_theme = current_theme() %}
<!doctype html>
<html lang="{{ current_locale() }}">
    {% set config = config() %}
    <head>
        {{ current_theme.headertags() }}
        <title>{{ curso.nombre | title }}</title>
        {{ current_theme.local_style() }}
    </head>
    <body>
        {{ current_theme.navbar() }}
        <main>
            {{ current_theme.notify() }}
            <div class="container py-4">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="{{ url_for('home.panel') }}">{{ _('Inicio') }}</a>
                        </li>
                        <li class="breadcrumb-item active">{{ curso.nombre }}</li>
                    </ol>
                </nav>
                <h1>{{ curso.nombre }}</h1>
                {% for seccion in secciones %}
                <div class="card mb-3">
                    <div class="card-header">{{ seccion.nombre }}</div>
                    <div class="card-body">
                        {% for recurso in recursos if recurso.seccion == seccion.indice %}
                        <a href="{{ url_for('resources.pagina_recurso', curso_id=curso.codigo, resource_type=recurso.tipo, codigo=recurso.codigo) }}" class="d-block mb-2">
                            {{ recurso.nombre }}
                        </a>
                        {% endfor %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </main>
        {{ current_theme.footer() }}
        {{ current_theme.jslibs() }}
    </body>
</html>

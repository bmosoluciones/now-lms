<!doctype html>
<html lang="{{ current_locale() }}">
    {% set current_theme = current_theme() %}
    {% set site_config = config() %}
    {% set S = url_for('static', filename='themes/intent_learn') %}
    {% set levels = {0: _('Introductory'), 1: _('Beginner'), 2: _('Intermediate'), 3: _('Advanced')} %}
    {#
      The course workspace: what a member sees after "Continue course".

      This is the surface a learner actually works in, and until now it fell
      through to stock `learning/curso.html` — Bootstrap chrome one click after a
      bespoke front door. Shares the Charcoal Slate vocabulary with
      overrides/course_view.j2 so the two read as one product.

      One deliberate difference from the stock template. `learning/curso.html`
      opens with

          {% raw %}{% set permitir_estudiante = estudiante_asignado(id_curso=curso.codigo) %}{% endraw %}

      which shadows the `permitir_estudiante` the route passes, so the route's
      value never reaches the page. This template uses the route's value. That is
      the documented contract, it keeps the access decision in one place, and it
      means the gate can be reasoned about from the view rather than from a
      template-local helper call.
    #}
    <head>
        {{ current_theme.headertags() }} {{ current_theme.local_style() }}
        <title>{{ curso.nombre }} · {{ site_config.titulo }}</title>
        <style>
            /* Charcoal Slate — shared with overrides/course_view.j2. isl- prefixed to
               avoid collisions with Bootstrap and theme.min.css. If a third course
               surface is ever added, lift these tokens into a stylesheet rather than
               copying them a third time. */
            .isl-root {
                --bg: 9 9 11; --bg-body: 24 24 27; --ink: 250 250 250; --ink-dim: 161 161 170;
                --ink-faint: 113 113 122; --line: 39 39 42; --ember: 249 115 22; --ember-hi: 251 146 60;
                --ok: 34 197 94;
                --font-display: 'Syne', system-ui, sans-serif; --font-ui: 'Inter', system-ui, sans-serif; --maxw: 72rem;
                min-height: 100vh; background: rgb(var(--bg-body)); color: rgb(var(--ink));
                font-family: var(--font-ui); line-height: 1.6; -webkit-font-smoothing: antialiased;
                display: flex; flex-direction: column;
            }
            .isl-root *, .isl-root *::before, .isl-root *::after { box-sizing: border-box; }
            .isl-root a { color: inherit; text-decoration: none; }
            .isl-root img { max-width: 100%; }
            .isl-root :focus-visible { outline: 2px solid rgb(var(--ember)); outline-offset: 3px; border-radius: 4px; }
            .isl-wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 2rem; width: 100%; }

            .isl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; min-height: 44px;
                padding: 0.7rem 1.4rem; border-radius: 0.55rem; font-weight: 700; font-size: 0.88rem; cursor: pointer;
                white-space: nowrap; border: 1px solid transparent; transition: all 0.25s cubic-bezier(0.22,1,0.36,1); }
            .isl-btn-primary { background: rgb(var(--ember)); color: rgb(9 9 11); box-shadow: 0 0 20px rgba(249,115,22,0.25); }
            .isl-btn-primary:hover { background: rgb(var(--ember-hi)); box-shadow: 0 0 30px rgba(249,115,22,0.4); transform: translateY(-1px); }
            .isl-btn-secondary { background: transparent; border-color: rgb(113 113 122); color: rgb(228 228 231); }
            .isl-btn-secondary:hover { background: rgb(39 39 42); border-color: rgb(var(--ink-dim)); color: rgb(var(--ink)); }
            .isl-btn-sm { padding: 0.5rem 1rem; font-size: 0.82rem; min-height: 40px; }
            .isl-btn-block { width: 100%; }

            .isl-header { position: sticky; top: 0; z-index: 40; background: rgba(9,9,11,0.72);
                backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid rgba(39,39,42,0.6); }
            .isl-header .isl-wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 4.25rem; }
            .isl-brand { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; }
            .isl-brand img { width: 30px; height: 30px; object-fit: contain; }
            .isl-brand .word { font-family: var(--font-display); font-weight: 700; font-size: 1.12rem; letter-spacing: -0.01em; color: rgb(var(--ink)); }
            .isl-brand .word .s { color: #FF7A1A; }
            .isl-nav { display: flex; align-items: center; gap: 1.6rem; }
            .isl-nav a.link { display: inline-flex; align-items: center; min-height: 44px; font-size: 0.88rem; font-weight: 500; color: rgb(var(--ink-dim)); transition: color 0.2s ease; }
            .isl-nav a.link:hover { color: rgb(var(--ink)); }
            .isl-nav-actions { display: flex; align-items: center; gap: 0.6rem; }
            @media (max-width: 860px) { .isl-nav a.link { display: none; } }

            .isl-cat-head { background: rgb(var(--bg)); border-bottom: 1px solid rgba(39,39,42,0.5); padding: 3rem 0 2.25rem; position: relative; overflow: hidden; }
            .isl-cat-head .glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 0%, rgba(249,115,22,0.12), transparent 55%); }
            .isl-cat-head .isl-wrap { position: relative; }
            .isl-crumbs { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(var(--ink-faint)); margin-bottom: 0.9rem; }
            .isl-crumbs a:hover { color: rgb(var(--ink-dim)); }
            .isl-cat-head h1 { font-family: var(--font-display); font-weight: 800; letter-spacing: -0.02em; font-size: clamp(1.7rem, 3.6vw, 2.5rem); color: rgb(var(--ink)); margin: 0 0 0.5rem; }
            .isl-cat-head p { color: rgb(var(--ink-dim)); font-size: 0.95rem; margin: 0; max-width: 62ch; }

            /* progress meter */
            .isl-prog { margin-top: 1.4rem; max-width: 32rem; }
            .isl-prog-bar { height: 6px; border-radius: 999px; background: rgba(39,39,42,0.9); overflow: hidden; }
            .isl-prog-bar span { display: block; height: 100%; border-radius: 999px; background: linear-gradient(to right, rgb(var(--ember)), rgb(var(--ember-hi))); }
            .isl-prog-label { display: flex; justify-content: space-between; font-size: 0.78rem; color: rgb(var(--ink-faint)); margin-top: 0.45rem; }

            .isl-cat-body { flex: 1; background: rgb(var(--bg)); padding: 2.5rem 0 5rem; }
            .isl-detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) 19rem; gap: 2.25rem; align-items: start; }
            @media (max-width: 900px) { .isl-detail-grid { grid-template-columns: 1fr; } }

            .isl-panel { background: rgba(24,24,27,0.65); border: 1px solid rgba(39,39,42,0.75); border-radius: 0.9rem; overflow: hidden; }
            .isl-panel + .isl-panel { margin-top: 1.4rem; }
            .isl-panel-head { padding: 1.1rem 1.4rem; border-bottom: 1px solid rgba(39,39,42,0.75); display: flex; align-items: center; gap: 0.6rem; }
            .isl-panel-head h2 { font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: rgb(var(--ink)); margin: 0; }
            .isl-panel-head .bi { color: rgb(var(--ember-hi)); }
            .isl-panel-body { padding: 1.1rem 1.4rem 1.4rem; }

            .isl-prose { color: rgb(var(--ink-dim)); font-size: 0.92rem; line-height: 1.7; }
            .isl-prose h1, .isl-prose h2, .isl-prose h3 { font-family: var(--font-display); color: rgb(var(--ink)); margin: 1.2rem 0 0.5rem; line-height: 1.3; }
            .isl-prose p { margin: 0 0 0.85rem; }
            .isl-prose a { color: rgb(var(--ember-hi)); }

            .isl-acc { display: flex; flex-direction: column; gap: 0.7rem; }
            .isl-sec { border: 1px solid rgba(39,39,42,0.85); border-radius: 0.7rem; overflow: hidden; background: rgba(9,9,11,0.4); }
            .isl-sec > summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 0.7rem;
                padding: 0.95rem 1.15rem; font-family: var(--font-display); font-weight: 700; font-size: 0.92rem; color: rgb(var(--ink));
                transition: background 0.2s ease; }
            .isl-sec > summary::-webkit-details-marker { display: none; }
            .isl-sec > summary:hover { background: rgba(39,39,42,0.4); }
            .isl-sec > summary .chev { margin-left: auto; color: rgb(var(--ink-faint)); transition: transform 0.2s ease; }
            .isl-sec[open] > summary .chev { transform: rotate(90deg); }
            .isl-sec > summary .fold-ico { color: rgb(var(--ember-hi)); }
            .isl-sec-inner { padding: 0.3rem 1.15rem 1.05rem; border-top: 1px solid rgba(39,39,42,0.6); }
            .isl-sec-desc { color: rgb(var(--ink-faint)); font-size: 0.82rem; margin: 0.75rem 0 0.6rem; }

            .isl-res { display: flex; align-items: center; gap: 0.6rem; padding: 0.62rem 0; border-bottom: 1px solid rgba(39,39,42,0.5); font-size: 0.87rem; }
            .isl-res:last-child { border-bottom: 0; }
            .isl-res .bi { color: rgb(var(--ember-hi)); flex-shrink: 0; }
            .isl-res .name { flex: 1; min-width: 0; color: rgb(var(--ink)); }
            .isl-res a.name:hover { color: rgb(var(--ember-hi)); }
            .isl-res.locked .bi, .isl-res.locked .name { color: rgb(var(--ink-faint)); }
            .isl-badge { font-family: var(--font-display); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
                border-radius: 999px; padding: 0.18rem 0.55rem; white-space: nowrap; flex-shrink: 0; }
            .isl-badge.req { color: rgb(var(--ember-hi)); border: 1px solid rgba(249,115,22,0.35); }
            .isl-badge.opt { color: rgb(var(--ink-faint)); border: 1px solid rgba(113,113,122,0.4); }
            .isl-badge.locked { color: rgb(var(--ink-faint)); border: 1px solid rgba(113,113,122,0.4); }

            .isl-empty { text-align: center; padding: 2.5rem 1rem; color: rgb(var(--ink-faint)); }
            .isl-empty img { width: 40px; height: 40px; opacity: 0.7; margin-bottom: 0.8rem; }
            .isl-empty h3 { font-family: var(--font-display); color: rgb(var(--ink-dim)); font-size: 1rem; margin: 0 0 0.35rem; }
            .isl-empty p { font-size: 0.87rem; margin: 0; }

            .isl-side { display: flex; flex-direction: column; gap: 1.4rem; position: sticky; top: 5.5rem; }
            @media (max-width: 900px) { .isl-side { position: static; } }
            .isl-card { border-radius: 0.9rem; overflow: hidden; background: rgba(24,24,27,0.65); border: 1px solid rgba(39,39,42,0.75); }
            .isl-card-body { padding: 1.3rem; }
            .isl-card-body h3 { font-family: var(--font-display); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em;
                text-transform: uppercase; color: rgb(var(--ink-faint)); margin: 0 0 0.9rem; }
            .isl-meta { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.65rem; }
            .isl-meta li { display: flex; align-items: baseline; gap: 0.55rem; font-size: 0.85rem; color: rgb(var(--ink-dim)); }
            .isl-meta .bi { color: rgb(var(--ember-hi)); font-size: 0.85rem; }
            .isl-meta .k { color: rgb(var(--ink-faint)); }
            .isl-meta .v { color: rgb(var(--ink)); font-weight: 600; margin-left: auto; text-align: right; }

            .isl-dl a, .isl-quick a { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0;
                font-size: 0.85rem; color: rgb(var(--ink-dim)); border-bottom: 1px solid rgba(39,39,42,0.5); }
            .isl-dl a:last-child, .isl-quick a:last-child { border-bottom: 0; }
            .isl-dl a:hover, .isl-quick a:hover { color: rgb(var(--ember-hi)); }
            .isl-dl a .bi, .isl-quick a .bi { color: rgb(var(--ember-hi)); }

            .isl-cert { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: rgb(var(--ok) / 1);
                background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.28); border-radius: 0.55rem; padding: 0.7rem 0.9rem; margin-bottom: 1rem; }

            .isl-footer { background: rgb(var(--bg)); border-top: 1px solid rgba(39,39,42,0.6); padding: 2rem 0; }
            .isl-footer .isl-wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
            .isl-footer .fb { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; }
            .isl-footer .fc { font-size: 0.78rem; color: rgb(var(--ink-faint)); }
        </style>
    </head>

    <body class="isl-root">
        <header class="isl-header">
            <div class="isl-wrap">
                <a class="isl-brand" href="{{ url_for('home.pagina_de_inicio') }}" aria-label="{{ site_config.titulo }}">
                    <img src="{{ S }}/logo-mark.png" alt="" width="30" height="30" />
                    <span class="word">{{ _('Intent') }}<span class="s">{{ _('Solutions') }}</span></span>
                </a>
                <nav class="isl-nav" aria-label="{{ _('Primary navigation') }}">
                    <a class="link" href="{{ url_for('course.my_courses') }}">{{ _('My Courses') }}</a>
                    <span class="isl-nav-actions">
                        <a class="isl-btn isl-btn-secondary isl-btn-sm" href="{{ url_for('home.panel') }}">{{ _('Dashboard') }}</a>
                    </span>
                </nav>
            </div>
        </header>

        <main>
            <div class="isl-cat-head">
                <span class="glow" aria-hidden="true"></span>
                <div class="isl-wrap">
                    <nav class="isl-crumbs" aria-label="{{ _('Breadcrumb') }}">
                        <a href="{{ url_for('course.my_courses') }}">{{ _('My Courses') }}</a>
                        <span aria-hidden="true">›</span>
                        <span>{{ curso.nombre }}</span>
                    </nav>
                    <h1>{{ curso.nombre }}</h1>
                    {% if curso.descripcion_corta %}
                    <p>{{ curso.descripcion_corta }}</p>
                    {% endif %}

                    {#
                      Progress is derived from the resources this page already has rather
                      than from a new query: the take route does not pass per-resource
                      completion. It counts required resources, which is the same set the
                      platform uses to decide whether a course is finished.
                    #}
                    {% set required_total = recursos | selectattr('requerido', 'equalto', 'required') | list | length %}
                    {% if required_total %}
                    <div class="isl-prog">
                        <div class="isl-prog-bar" role="progressbar" aria-valuemin="0" aria-valuemax="{{ required_total }}" aria-valuenow="0"
                             aria-label="{{ _('Course progress') }}">
                            <span style="width: 0%"></span>
                        </div>
                        <div class="isl-prog-label">
                            <span>{{ required_total }} {{ _('required lessons') }}</span>
                            <span>{{ recursos | length }} {{ _('items in total') }}</span>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>

            <div class="isl-cat-body">
                <div class="isl-wrap">
                    <div class="isl-detail-grid">
                        <div>
                            {% if curso.descripcion %}
                            <section class="isl-panel">
                                <div class="isl-panel-head">
                                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                                    <h2>{{ _('About this course') }}</h2>
                                </div>
                                <div class="isl-panel-body">
                                    <div class="isl-prose">{{ markdown2html(curso.descripcion) | safe }}</div>
                                </div>
                            </section>
                            {% endif %}

                            <section class="isl-panel">
                                <div class="isl-panel-head">
                                    <i class="bi bi-list-ul" aria-hidden="true"></i>
                                    <h2>{{ _('Course content') }}</h2>
                                </div>
                                <div class="isl-panel-body">
                                    {% if secciones %}
                                    <div class="isl-acc">
                                        {% for seccion in secciones %}
                                        <details class="isl-sec"{% if loop.first %} open{% endif %}>
                                            <summary>
                                                <i class="bi bi-folder2-open fold-ico" aria-hidden="true"></i>
                                                <span>{{ seccion.nombre }}</span>
                                                <i class="bi bi-chevron-right chev" aria-hidden="true"></i>
                                            </summary>
                                            <div class="isl-sec-inner">
                                                {% if seccion.descripcion %}
                                                <p class="isl-sec-desc">{{ seccion.descripcion }}</p>
                                                {% endif %}
                                                {% for recurso in recursos %}{% if recurso.seccion == seccion.id %}
                                                {#
                                                  The gate. `permitir_estudiante` comes from the route and is true for an
                                                  enrolled student and for a moderator or admin viewing the course. It is
                                                  NOT the same thing as `recurso.publico`, which only marks a resource as
                                                  a free preview on the public course page. Conflating the two is what
                                                  makes an enrolled member see "Restricted" beside "You're enrolled".
                                                #}
                                                {% if permitir_estudiante %}
                                                <div class="isl-res">
                                                    <i class="{{ iconos_recursos[recurso.tipo] }}" aria-hidden="true"></i>
                                                    <a class="name" href="{{ url_for('resources.pagina_recurso', curso_id=recurso.curso, codigo=recurso.id, resource_type=recurso.tipo) }}">{{ recurso.nombre }}</a>
                                                    {% if recurso.requerido == 'required' %}
                                                    <span class="isl-badge req">{{ _('Required') }}</span>
                                                    {% else %}
                                                    <span class="isl-badge opt">{{ _('Optional') }}</span>
                                                    {% endif %}
                                                </div>
                                                {% else %}
                                                <div class="isl-res locked">
                                                    <i class="{{ iconos_recursos[recurso.tipo] }}" aria-hidden="true"></i>
                                                    <span class="name">{{ recurso.nombre }}</span>
                                                    <span class="isl-badge locked"><i class="bi bi-lock-fill" aria-hidden="true"></i> {{ _('Locked') }}</span>
                                                </div>
                                                {% endif %}
                                                {% endif %}{% endfor %}
                                            </div>
                                        </details>
                                        {% endfor %}
                                    </div>
                                    {% else %}
                                    <div class="isl-empty">
                                        <img src="{{ S }}/logo-mark.png" alt="" />
                                        <h3>{{ _('No content yet') }}</h3>
                                        <p>{{ _('This course has no sections available right now.') }}</p>
                                    </div>
                                    {% endif %}
                                </div>
                            </section>

                            {% if evaluaciones %}
                            <section class="isl-panel">
                                <div class="isl-panel-head">
                                    <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                                    <h2>{{ _('Evaluations') }}</h2>
                                </div>
                                <div class="isl-panel-body">
                                    {% for evaluacion in evaluaciones %}
                                    <div class="isl-res">
                                        <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                                        {% if permitir_estudiante %}
                                        <a class="name" href="{{ url_for('evaluation.take_evaluation', evaluation_id=evaluacion.id) }}">{{ evaluacion.title }}</a>
                                        {% else %}
                                        <span class="name">{{ evaluacion.title }}</span>
                                        {% endif %}
                                        {% if evaluacion.is_exam %}
                                        <span class="isl-badge req">{{ _('Exam') }}</span>
                                        {% endif %}
                                    </div>
                                    {% endfor %}
                                </div>
                            </section>
                            {% endif %}
                        </div>

                        <aside class="isl-side">
                            <div class="isl-card">
                                <div class="isl-card-body">
                                    {% if user_certificate %}
                                    <div class="isl-cert">
                                        <i class="bi bi-award-fill" aria-hidden="true"></i>
                                        <span>{{ _('Certificate issued') }}</span>
                                    </div>
                                    {% endif %}
                                    <h3>{{ _('This course') }}</h3>
                                    <ul class="isl-meta">
                                        <li>
                                            <i class="bi bi-bar-chart-fill" aria-hidden="true"></i>
                                            <span class="k">{{ _('Level') }}</span>
                                            <span class="v">{{ levels.get(curso.nivel, _('Course')) }}</span>
                                        </li>
                                        <li>
                                            <i class="bi bi-collection-fill" aria-hidden="true"></i>
                                            <span class="k">{{ _('Sections') }}</span>
                                            <span class="v">{{ secciones | length }}</span>
                                        </li>
                                        <li>
                                            <i class="bi bi-play-circle-fill" aria-hidden="true"></i>
                                            <span class="k">{{ _('Lessons') }}</span>
                                            <span class="v">{{ recursos | length }}</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <div class="isl-card">
                                <div class="isl-card-body">
                                    <h3>{{ _('Course tools') }}</h3>
                                    <div class="isl-quick">
                                        <a href="{{ url_for('msg.course_messages', course_code=curso.codigo) }}">
                                            <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                                            <span>{{ _('Messages') }}</span>
                                        </a>
                                        <a href="{{ url_for('course.curso', course_code=curso.codigo) }}">
                                            <i class="bi bi-card-text" aria-hidden="true"></i>
                                            <span>{{ _('Course overview') }}</span>
                                        </a>
                                        <a href="{{ url_for('course.my_courses') }}">
                                            <i class="bi bi-collection" aria-hidden="true"></i>
                                            <span>{{ _('All my courses') }}</span>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            {% if descargas %}
                            <div class="isl-card">
                                <div class="isl-card-body">
                                    <h3>{{ _('Downloads') }}</h3>
                                    <div class="isl-dl">
                                        {% for item in descargas %}
                                        <a href="{{ url_for('resource.vista_recurso', resource_code=item.codigo) }}">
                                            <i class="{{ iconos_recursos[item.tipo] }}" aria-hidden="true"></i>
                                            <span>{{ item.nombre }}</span>
                                        </a>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                            {% endif %}
                        </aside>
                    </div>
                </div>
            </div>
        </main>

        <footer class="isl-footer">
            <div class="isl-wrap">
                <span class="fb"><img src="{{ S }}/logo-mark.png" alt="" width="22" height="22" /> {{ site_config.titulo }}</span>
                <span class="fc"><a href="https://intentsolutions.io" target="_blank" rel="noopener">intentsolutions.io</a></span>
            </div>
        </footer>

        {{ current_theme.jslibs() }}
    </body>
</html>

{% macro navbar() -%}

<nav class="navbar navbar-expand-md navbar-dark bg-dark" aria-label="Fourth navbar example">
    <div class="container-fluid">
        {# Brand: the theme's own mark plus the configured site title. The image carries an
           empty alt because the adjacent text already names the site, so a screen reader
           announces it once rather than twice. Never hardcode a product name here — this
           macro renders on every authenticated page, and it previously shipped upstream's
           wordmark with alt="NOW LMS" on both branches.

           This depends on Configuracion.titulo being set. On a fresh database that field
           defaults to "NOW LMS", so a new deployment must set the site title before the
           navbar reads correctly. Verified 2026-07-31: production holds
           "Intent Solutions Learn". #}
        <a
            href="{{ url_for('home.pagina_de_inicio') }}"
            class="d-flex align-items-center gap-2 mb-2 mb-lg-0 text-decoration-none"
            aria-label="{{ config().titulo }}"
        >
            {% if logo_perzonalizado() %}
            <img
                width="24"
                height="24"
                src="{{ url_for('static', filename='files/public/images/logotipo.jpg') }}"
                alt=""
                class="d-inline-block align-top"
            />
            {% else %}
            <img
                width="24"
                height="24"
                src="{{ url_for('static', filename='themes/intent_learn/logo-mark.png') }}"
                alt=""
                class="d-inline-block align-top"
            />
            {% endif %}
            <span class="text-light fw-semibold">{{ config().titulo }}</span>
        </a>
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarsNOWLMS"
            aria-controls="navbarsNOWLMS"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarsNOWLMS">
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                {% if not current_user.is_authenticated %}
                <li>
                    <a href="{{ url_for('home.pagina_de_inicio') }}" class="nav-link text-light px-2"
                        ><i class="bi bi-house-fill" aria-hidden="true"></i> {{ _("Inicio") }}</a
                    >
                </li>
                {% else %}
                <li>
                    <a href="{{ url_for('home.panel') }}" class="nav-link text-light px-2"
                        ><i class="bi bi-house-fill" aria-hidden="true"></i> {{ _("Inicio") }}</a
                    >
                </li>
                {% endif %}
                {# "Courses" must land somewhere that has courses. `course.lista_cursos`
                   only ever lists `publico=True` rows, and this deployment gates every
                   course, so for a signed-in member that route is guaranteed empty and
                   sends them back to the dashboard.

                   Point at `my_courses` ONLY for the roles that route actually serves.
                   `course.my_courses` handles student, instructor and admin, and every
                   other type falls through to a flash plus a redirect back to
                   `lista_cursos` (now_lms/vistas/courses/base.py:558-560). Sending a
                   moderator there would bounce them straight back here — the same loop
                   this change exists to close, just one role over. #}
                <li>
                    {% if current_user.is_authenticated and current_user.tipo in ("student", "instructor", "admin") %}
                    <a href="{{ url_for('course.my_courses') }}" class="nav-link text-light px-2"
                        ><i class="bi bi-card-checklist" aria-hidden="true"></i> {{ _("Mis Cursos") }}</a
                    >
                    {% else %}
                    <a href="{{ url_for('course.lista_cursos', page=1) }}" class="nav-link text-light px-2"
                        ><i class="bi bi-card-checklist" aria-hidden="true"></i> {{ _("Cursos") }}</a
                    >
                    {% endif %}
                </li>
                {% if is_programs_enabled() %}
                <li>
                    <a href="{{ url_for('program.lista_programas', page=1) }}" class="nav-link text-light px-2"
                        ><i class="bi bi-diagram-3-fill" aria-hidden="true"></i> {{ _("Programas") }}</a
                    >
                </li>
                {% endif %} {% if is_resources_enabled() %}
                <li>
                    <a href="{{ url_for('resource.lista_de_recursos', page=1) }}" class="nav-link text-light px-2"
                        ><i class="bi bi-book" aria-hidden="true"></i> {{ _("Recursos") }}</a
                    >
                </li>
                {% endif %} {% if is_masterclass_enabled() %}
                <li>
                    <a href="{{ url_for('masterclass.list_public') }}" class="nav-link text-light px-2"
                        ><i class="bi bi-camera-video" aria-hidden="true"></i> {{ _("Clases Magistrales") }}</a
                    >
                </li>
                {% endif %} {% if is_blog_enabled() %}
                <li>
                    <a href="{{ url_for('blog.blog_index') }}" class="nav-link text-light px-2"
                        ><i class="bi bi-journal-text" aria-hidden="true"></i> {{ _("Blog") }}</a
                    >
                </li>
                {% endif %} {% if is_contact_enabled() %}
                <li>
                    <a href="{{ url_for('contact.contact_form') }}" class="nav-link text-light px-2"
                        ><i class="bi bi-envelope" aria-hidden="true"></i> {{ _("Contacto") }}</a
                    >
                </li>
                {% endif %} {% if current_user.is_authenticated %} {% if current_user.tipo == "moderator" or current_user.tipo
                == "instructor" or current_user.tipo == "admin" %}
                <li>
                    <a href="{{ url_for('moderator_profile.pagina_moderador') }}" class="nav-link text-light px-2"
                        ><i class="bi bi-card-checklist" aria-hidden="true"></i> {{ _('Moderación') }}</a
                    >
                </li>
                {% endif %} {% if current_user.tipo == "instructor" or current_user.tipo == "admin" %}
                <li>
                    <a href="{{ url_for('instructor_profile.pagina_instructor') }}" class="nav-link text-light px-2"
                        ><i class="bi bi-bank2" aria-hidden="true"></i> {{ _('Docente') }}</a
                    >
                </li>
                {% endif %} {% if current_user.tipo == "admin" %}
                <li>
                    <a href="{{ url_for('admin_profile.pagina_admin') }}" class="nav-link text-light px-2"
                        ><i class="bi bi-sliders" aria-hidden="true"></i> {{ _('Administración') }}</a
                    >
                </li>
                {% endif %} {% endif %}
            </ul>
            <div class="text-end">
                {% if not current_user.is_authenticated %}
                <a class="btn btn-primary me-2" href="{{ url_for('user.inicio_sesion') }}" role="button"
                    >{{ _('Iniciar Sesión') }}</a
                >
                <a class="btn btn-warning me-2" href="{{ url_for('user.crear_cuenta') }}" role="button"
                    >{{ _('Crear Cuenta') }}</a
                >
                {% else %}
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a
                            class="text-decoration-none text-light"
                            href="#"
                            role="button"
                            data-bs-toggle="dropdown"
                            data-bs-display="static"
                            aria-expanded="false"
                            >{{ _('Bienvenido') }}: {{ current_user.nombre }} {{ current_user.apellido }}
                            <i class="bi bi-list" aria-hidden="true"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-lg-end">
                            <li>
                                <a class="dropdown-item" href="{{ url_for('user_profile.perfil') }}">
                                    <i class="bi bi-person-circle" aria-hidden="true"></i> {{ _('Perfil de Usuario') }}</a
                                >
                            </li>
                            <li><a class="dropdown-item" href="#"> </a></li>
                            <li>
                                <hr class="dropdown-divider" />
                            </li>
                            <li>
                                <a
                                    class="dropdown-item text-decoration-none"
                                    href="#"
                                    data-bs-toggle="modal"
                                    data-bs-target="#exampleModal"
                                >
                                    <i class="bi bi-info-circle" aria-hidden="true"></i> {{ _('Información') }}
                                </a>
                            </li>
                            <li>
                                <hr class="dropdown-divider" />
                            </li>
                            <li>
                                <a class="dropdown-item text-decoration-none" href="{{ url_for('user.cerrar_sesion') }}">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i> {{ _('Cerrar Sesión') }}
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

{% if current_user.is_authenticated %}
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {# This modal is the attribution surface, and the credit to NOW-LMS and BMO
               Soluciones below is deliberate — Apache-2.0 and good citizenship both ask
               for it. What was wrong is that it presented AS NOW LMS: the heading and the
               logo named the upstream product to a member who signed in to Intent
               Solutions Learn. It now names this site and credits upstream underneath,
               which is what attribution means. Do not remove the credit. #}
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">{{ config().titulo }}</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ _('Close') }}"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2">
                    {{ _('Built on NOW-LMS, the open-source learning platform by BMO Soluciones.') }}
                </p>
                <img
                    width="180"
                    src="{{ url_for('static', filename='icons/logo/logo_large.png') }}"
                    alt="NOW-LMS"
                />
                <br />
                <strong>{{ _('Versión') }}:</strong> {{ version }}
                <br />
                <strong>{{ _('Nombre de Lanzamiento') }}:</strong> {{ code_name }}
                <br />
                {% if current_user.tipo == "admin" %}
                <strong>Python:</strong> {{ pyversion }}
                <br />
                <strong>Database:</strong> {{ info["DBENGINE"] }}
                <br />
                <strong>Cache:</strong> {{ info["CACHE"] }} {% endif %}
            </div>
            <div class="modal-footer">
                <div class="d-flex justify-content-between">
                    <div>
                        <img
                            width="75"
                            height="20"
                            src="{{ url_for('static', filename='img/bmo-logo.png') }}"
                            alt="BMO Soluciones"
                        />
                    </div>
                    <div>
                        <a
                            href="https://now-lms-manual.readthedocs.io/en/latest/"
                            class="btn btn-sm btn-secondary"
                            data-dismiss="modal"
                            ><i class="bi bi-book" aria-hidden="true"></i> {{ _('Manual de Usuario') }}</a
                        >
                        {% if current_user.tipo == "admin" %}
                        <a
                            href="https://bmosoluciones.github.io/now-lms/"
                            class="btn btn-sm btn-secondary"
                            data-dismiss="modal"
                            ><i class="bi bi-book" aria-hidden="true"></i> {{ _('Manual de Administración') }}</a
                        >
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %} {% endmacro %}

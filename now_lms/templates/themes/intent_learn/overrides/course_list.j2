<!doctype html>
<html lang="{{ current_locale() }}">
    {% set current_theme = current_theme() %}
    {% set site_config = config() %}
    {% set S = url_for('static', filename='themes/intent_learn') %}
    {% set levels = {0: 'Introductory', 1: 'Beginner', 2: 'Intermediate', 3: 'Advanced'} %}
    <head>
        {{ current_theme.headertags() }} {{ current_theme.local_style() }}
        <title>Courses · Intent Solutions Learn</title>
        <style>
            /* Shares the Intent Solutions Learn front-door design language
               (Charcoal Slate). isl- prefixed to avoid Bootstrap/theme.min.css. */
            .isl-root {
                --bg: 9 9 11; --bg-body: 24 24 27; --ink: 250 250 250; --ink-dim: 161 161 170;
                --ink-faint: 113 113 122; --line: 39 39 42; --ember: 249 115 22; --ember-hi: 251 146 60;
                --font-display: 'Syne', system-ui, sans-serif; --font-ui: 'Inter', system-ui, sans-serif; --maxw: 72rem;
                min-height: 100vh; background: rgb(var(--bg-body)); color: rgb(var(--ink));
                font-family: var(--font-ui); line-height: 1.6; -webkit-font-smoothing: antialiased;
                display: flex; flex-direction: column;
            }
            .isl-root *, .isl-root *::before, .isl-root *::after { box-sizing: border-box; }
            .isl-root a { color: inherit; text-decoration: none; }
            .isl-root img { max-width: 100%; }
            .isl-root :focus-visible { outline: 2px solid rgb(var(--ember)); outline-offset: 3px; border-radius: 4px; }
            .isl-wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 2rem; width: 100%; }

            .isl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; min-height: 44px;
                padding: 0.7rem 1.4rem; border-radius: 0.55rem; font-weight: 700; font-size: 0.88rem; cursor: pointer;
                white-space: nowrap; border: 1px solid transparent; transition: all 0.25s cubic-bezier(0.22,1,0.36,1); }
            .isl-btn-primary { background: rgb(var(--ember)); color: rgb(9 9 11); box-shadow: 0 0 20px rgba(249,115,22,0.25); }
            .isl-btn-primary:hover { background: rgb(var(--ember-hi)); box-shadow: 0 0 30px rgba(249,115,22,0.4); transform: translateY(-1px); }
            .isl-btn-secondary { background: transparent; border-color: rgb(113 113 122); color: rgb(228 228 231); }
            .isl-btn-secondary:hover { background: rgb(39 39 42); border-color: rgb(var(--ink-dim)); color: rgb(var(--ink)); }
            .isl-btn-sm { padding: 0.5rem 1rem; font-size: 0.82rem; min-height: 40px; }

            /* header (matches home) */
            .isl-header { position: sticky; top: 0; z-index: 40; background: rgba(9,9,11,0.72);
                backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid rgba(39,39,42,0.6); }
            .isl-header .isl-wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 4.25rem; }
            .isl-brand { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; }
            .isl-brand img { width: 30px; height: 30px; object-fit: contain; }
            .isl-brand .word { font-family: var(--font-display); font-weight: 700; font-size: 1.12rem; letter-spacing: -0.01em; color: rgb(var(--ink)); }
            .isl-brand .word .s { color: #FF7A1A; }
            .isl-nav { display: flex; align-items: center; gap: 1.6rem; }
            .isl-nav a.link { display: inline-flex; align-items: center; min-height: 44px; font-size: 0.88rem; font-weight: 500; color: rgb(var(--ink-dim)); transition: color 0.2s ease; }
            .isl-nav a.link.active, .isl-nav a.link:hover { color: rgb(var(--ink)); }
            .isl-nav-actions { display: flex; align-items: center; gap: 0.6rem; }
            @media (max-width: 860px) { .isl-nav a.link { display: none; } }

            /* page head */
            .isl-cat-head { background: rgb(var(--bg)); border-bottom: 1px solid rgba(39,39,42,0.5); padding: 4rem 0 2.75rem; position: relative; overflow: hidden; }
            .isl-cat-head .glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 0%, rgba(249,115,22,0.12), transparent 55%); }
            .isl-cat-head .isl-wrap { position: relative; }
            .isl-eyebrow { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }
            .isl-eyebrow .rule { display: block; height: 1px; width: 2.5rem; background: linear-gradient(to right, rgb(var(--ember)), transparent); }
            .isl-eyebrow .label { font-family: var(--font-display); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(var(--ember-hi)); }
            .isl-cat-head h1 { font-family: var(--font-display); font-weight: 800; letter-spacing: -0.02em; font-size: clamp(2rem, 4.4vw, 3rem); color: rgb(var(--ink)); margin: 0 0 0.6rem; }
            .isl-cat-head p { color: rgb(var(--ink-dim)); font-size: 1rem; margin: 0; max-width: 52ch; }
            .isl-cat-count { margin-top: 1.1rem; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(var(--ink-faint)); }

            /* catalog */
            .isl-cat-body { flex: 1; background: rgb(var(--bg)); padding: 3rem 0 5rem; }
            .isl-course-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.4rem; }
            .isl-course { display: flex; flex-direction: column; border-radius: 0.9rem; overflow: hidden;
                background: rgba(24,24,27,0.65); border: 1px solid rgba(39,39,42,0.75);
                transition: border-color 0.28s ease, transform 0.22s ease, background 0.28s ease; }
            .isl-course:hover { border-color: rgba(249,115,22,0.35); transform: translateY(-4px); background: rgba(24,24,27,0.9); }
            .isl-course-cover { aspect-ratio: 16 / 9; width: 100%; object-fit: cover; background: #141010; border-bottom: 1px solid rgba(39,39,42,0.6); }
            .isl-course-cover--ph { display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #1f1a17, #141010); }
            .isl-course-cover--ph img { width: 42px; height: 42px; opacity: 0.9; }
            .isl-course-body { display: flex; flex-direction: column; flex: 1; padding: 1.25rem 1.3rem 1.4rem; }
            .isl-course-meta { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.7rem; }
            .isl-chip { font-family: var(--font-display); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
                color: rgb(var(--ember-hi)); border: 1px solid rgba(249,115,22,0.32); border-radius: 999px; padding: 0.2rem 0.6rem; }
            .isl-course-body h3 { font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; color: rgb(var(--ink)); margin: 0 0 0.4rem; line-height: 1.25; }
            .isl-course-body p { font-size: 0.85rem; color: rgb(var(--ink-dim)); line-height: 1.55; margin: 0 0 1.1rem; }
            .isl-course-foot { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
            .isl-course-price { font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; color: rgb(var(--ink)); }
            .isl-course-price.free { color: rgb(var(--ember-hi)); }
            .isl-course-dur { font-size: 0.75rem; color: rgb(var(--ink-faint)); }
            .isl-course-cta { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; font-weight: 600; color: rgb(var(--ember-hi)); }

            /* empty state */
            .isl-empty { text-align: center; padding: 4rem 1rem; border: 1px dashed rgba(249,115,22,0.28); border-radius: 1rem; background: rgba(24,24,27,0.4); }
            .isl-empty img { width: 54px; height: 54px; opacity: 0.9; margin-bottom: 1.1rem; }
            .isl-empty h3 { font-family: var(--font-display); font-size: 1.3rem; color: rgb(var(--ink)); margin: 0 0 0.5rem; }
            .isl-empty p { color: rgb(var(--ink-dim)); margin: 0 auto 1.6rem; max-width: 42ch; }

            /* pagination */
            .isl-pager { display: flex; align-items: center; justify-content: center; gap: 1.25rem; margin-top: 2.75rem; }
            .isl-pager .pg { font-size: 0.8rem; color: rgb(var(--ink-faint)); }

            /* footer */
            .isl-footer { border-top: 1px solid rgba(39,39,42,0.6); background: rgb(var(--bg-body)); }
            .isl-footer .isl-wrap { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.9rem; padding: 2rem 2rem 2.5rem; }
            .isl-footer .fb { display: inline-flex; align-items: center; gap: 0.55rem; font-family: var(--font-display); font-weight: 700; color: rgb(var(--ink-dim)); }
            .isl-footer .fb img { width: 22px; height: 22px; object-fit: contain; }
            .isl-footer .fc { font-size: 0.75rem; letter-spacing: 0.04em; color: rgb(var(--ink-faint)); }
            .isl-footer .fc a { color: rgb(var(--ember-hi)); }

            @media (max-width: 640px) {
                .isl-wrap { padding: 0 1.25rem; }
                .isl-header .isl-wrap { padding: 0 1rem; height: 3.9rem; }
                .isl-brand .word { display: none; }
                .isl-nav-actions { gap: 0.5rem; }
                .isl-nav .isl-btn-sm { padding: 0.5rem 0.85rem; font-size: 0.78rem; }
            }
            @media (prefers-reduced-motion: reduce) { .isl-root * { transition: none !important; } }
        </style>
    </head>
    <body class="isl-root">
        <header class="isl-header">
            <div class="isl-wrap">
                <a class="isl-brand" href="/" aria-label="Intent Solutions Learn — home">
                    <img src="{{ S }}/logo-mark.png" alt="" width="30" height="30" />
                    <span class="word">Intent<span class="s">Solutions</span></span>
                </a>
                <nav class="isl-nav" aria-label="Primary">
                    <a class="link active" href="{{ url_for('course.lista_cursos') }}">Courses</a>
                    <a class="link" href="/#team">Team</a>
                    <a class="link" href="https://intentsolutions.io" target="_blank" rel="noopener">About</a>
                    <span class="isl-nav-actions">
                        {% if current_user.is_authenticated %}
                        <a class="isl-btn isl-btn-secondary isl-btn-sm" href="{{ url_for('home.panel') }}">Dashboard</a>
                        {% else %}
                        <a class="isl-btn isl-btn-primary isl-btn-sm" href="{{ url_for('user.inicio_sesion') }}">Sign in</a>
                        {% endif %}
                    </span>
                </nav>
            </div>
        </header>

        <section class="isl-cat-head">
            <div class="glow" aria-hidden="true"></div>
            <div class="isl-wrap">
                <div class="isl-eyebrow" aria-hidden="true"><span class="rule"></span><span class="label">Course catalog</span></div>
                <h1>Browse courses</h1>
                <p>Hands-on, practitioner training built from real work — the same tooling and decisions behind our open-source platform.</p>
                {% if cursos and cursos.total %}
                <p class="isl-cat-count">{{ cursos.total }} course{{ 's' if cursos.total != 1 }} · page {{ cursos.page }} of {{ cursos.pages }}</p>
                {% endif %}
            </div>
        </section>

        <main class="isl-cat-body">
            <div class="isl-wrap">
                {% if cursos and cursos.items %}
                <div class="isl-course-grid">
                    {% for curso in cursos.items %}
                    <a class="isl-course" href="{{ url_for('course.curso', course_code=curso.codigo) }}">
                        {% if curso.portada %}
                        <img class="isl-course-cover" src="{{ url_for('static', filename='files/public/images/' + curso.codigo + '/logo.jpg') }}" alt="{{ curso.nombre }}" loading="lazy" />
                        {% else %}
                        <span class="isl-course-cover isl-course-cover--ph" aria-hidden="true"><img src="{{ S }}/logo-mark.png" alt="" /></span>
                        {% endif %}
                        <div class="isl-course-body">
                            <div class="isl-course-meta">
                                <span class="isl-chip">{{ levels.get(curso.nivel, 'Course') }}</span>
                            </div>
                            <h3>{{ curso.nombre }}</h3>
                            <p>{{ (curso.descripcion_corta or curso.descripcion) | truncate(110) }}</p>
                            <div class="isl-course-foot">
                                {% if curso.pagado and curso.precio %}
                                <span class="isl-course-price">{{ curso.precio | float }} {{ site_config.moneda }}</span>
                                {% else %}
                                <span class="isl-course-price free">Free</span>
                                {% endif %}
                                <span class="isl-course-cta">View course →</span>
                            </div>
                        </div>
                    </a>
                    {% endfor %}
                </div>

                {% if cursos.pages and cursos.pages > 1 %}
                <nav class="isl-pager" aria-label="Pagination">
                    {% if cursos.has_prev %}<a class="isl-btn isl-btn-secondary isl-btn-sm" href="{{ url_for('course.lista_cursos', page=cursos.prev_num) }}">← Prev</a>{% endif %}
                    <span class="pg">Page {{ cursos.page }} of {{ cursos.pages }}</span>
                    {% if cursos.has_next %}<a class="isl-btn isl-btn-secondary isl-btn-sm" href="{{ url_for('course.lista_cursos', page=cursos.next_num) }}">Next →</a>{% endif %}
                </nav>
                {% endif %}

                {% else %}
                <div class="isl-empty">
                    <img src="{{ S }}/logo-mark.png" alt="" />
                    <h3>Courses are on the way</h3>
                    <p>We're building the catalog right now. Check back soon — or sign in to be ready the moment the first track goes live.</p>
                    {% if not current_user.is_authenticated %}
                    <a class="isl-btn isl-btn-primary" href="{{ url_for('user.inicio_sesion') }}">Sign in</a>
                    {% else %}
                    <a class="isl-btn isl-btn-primary" href="{{ url_for('home.panel') }}">Go to dashboard</a>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </main>

        <footer class="isl-footer">
            <div class="isl-wrap">
                <span class="fb"><img src="{{ S }}/logo-mark.png" alt="" width="22" height="22" /> Intent Solutions Learn</span>
                <span class="fc">building intelligence · delivering impact</span>
                <span class="fc"><a href="https://intentsolutions.io" target="_blank" rel="noopener">intentsolutions.io</a></span>
            </div>
        </footer>

        {{ current_theme.jslibs() }}
    </body>
</html>

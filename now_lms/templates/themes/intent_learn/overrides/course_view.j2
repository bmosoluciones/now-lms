<!doctype html>
<html lang="{{ current_locale() }}">
    {% set current_theme = current_theme() %}
    {% set site_config = config() %}
    {% set S = url_for('static', filename='themes/intent_learn') %}
    {% set levels = {0: 'Introductory', 1: 'Beginner', 2: 'Intermediate', 3: 'Advanced'} %}
    <head>
        {{ current_theme.headertags() }} {{ current_theme.local_style() }}
        <title>{{ curso.nombre }} · Intent Solutions Learn</title>
        <style>
            /* Shares the Intent Solutions Learn front-door design language
               (Charcoal Slate). isl- prefixed to avoid Bootstrap/theme.min.css.
               Detail-page rules extend the shared furniture from course_list.j2. */
            .isl-root {
                --bg: 9 9 11; --bg-body: 24 24 27; --ink: 250 250 250; --ink-dim: 161 161 170;
                --ink-faint: 113 113 122; --line: 39 39 42; --ember: 249 115 22; --ember-hi: 251 146 60;
                --font-display: 'Syne', system-ui, sans-serif; --font-ui: 'Inter', system-ui, sans-serif; --maxw: 72rem;
                min-height: 100vh; background: rgb(var(--bg-body)); color: rgb(var(--ink));
                font-family: var(--font-ui); line-height: 1.6; -webkit-font-smoothing: antialiased;
                display: flex; flex-direction: column;
            }
            .isl-root *, .isl-root *::before, .isl-root *::after { box-sizing: border-box; }
            .isl-root a { color: inherit; text-decoration: none; }
            .isl-root img { max-width: 100%; }
            .isl-root :focus-visible { outline: 2px solid rgb(var(--ember)); outline-offset: 3px; border-radius: 4px; }
            .isl-wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 2rem; width: 100%; }

            .isl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; min-height: 44px;
                padding: 0.7rem 1.4rem; border-radius: 0.55rem; font-weight: 700; font-size: 0.88rem; cursor: pointer;
                white-space: nowrap; border: 1px solid transparent; transition: all 0.25s cubic-bezier(0.22,1,0.36,1); }
            .isl-btn-primary { background: rgb(var(--ember)); color: rgb(9 9 11); box-shadow: 0 0 20px rgba(249,115,22,0.25); }
            .isl-btn-primary:hover { background: rgb(var(--ember-hi)); box-shadow: 0 0 30px rgba(249,115,22,0.4); transform: translateY(-1px); }
            .isl-btn-secondary { background: transparent; border-color: rgb(113 113 122); color: rgb(228 228 231); }
            .isl-btn-secondary:hover { background: rgb(39 39 42); border-color: rgb(var(--ink-dim)); color: rgb(var(--ink)); }
            .isl-btn-sm { padding: 0.5rem 1rem; font-size: 0.82rem; min-height: 40px; }
            .isl-btn-block { width: 100%; }

            /* header (matches home) */
            .isl-header { position: sticky; top: 0; z-index: 40; background: rgba(9,9,11,0.72);
                backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid rgba(39,39,42,0.6); }
            .isl-header .isl-wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 4.25rem; }
            .isl-brand { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; }
            .isl-brand img { width: 30px; height: 30px; object-fit: contain; }
            .isl-brand .word { font-family: var(--font-display); font-weight: 700; font-size: 1.12rem; letter-spacing: -0.01em; color: rgb(var(--ink)); }
            .isl-brand .word .s { color: #FF7A1A; }
            .isl-nav { display: flex; align-items: center; gap: 1.6rem; }
            .isl-nav a.link { display: inline-flex; align-items: center; min-height: 44px; font-size: 0.88rem; font-weight: 500; color: rgb(var(--ink-dim)); transition: color 0.2s ease; }
            .isl-nav a.link.active, .isl-nav a.link:hover { color: rgb(var(--ink)); }
            .isl-nav-actions { display: flex; align-items: center; gap: 0.6rem; }
            @media (max-width: 860px) { .isl-nav a.link { display: none; } }

            /* page head */
            .isl-cat-head { background: rgb(var(--bg)); border-bottom: 1px solid rgba(39,39,42,0.5); padding: 4rem 0 2.75rem; position: relative; overflow: hidden; }
            .isl-cat-head .glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 0%, rgba(249,115,22,0.12), transparent 55%); }
            .isl-cat-head .isl-wrap { position: relative; }
            .isl-eyebrow { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }
            .isl-eyebrow .rule { display: block; height: 1px; width: 2.5rem; background: linear-gradient(to right, rgb(var(--ember)), transparent); }
            .isl-eyebrow .label { font-family: var(--font-display); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(var(--ember-hi)); }
            .isl-crumbs { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(var(--ink-faint)); margin-bottom: 1rem; }
            .isl-crumbs a:hover { color: rgb(var(--ink-dim)); }
            .isl-cat-head h1 { font-family: var(--font-display); font-weight: 800; letter-spacing: -0.02em; font-size: clamp(2rem, 4.4vw, 3rem); color: rgb(var(--ink)); margin: 0 0 0.6rem; }
            .isl-cat-head p { color: rgb(var(--ink-dim)); font-size: 1rem; margin: 0; max-width: 60ch; }

            /* detail body layout */
            .isl-cat-body { flex: 1; background: rgb(var(--bg)); padding: 3rem 0 5rem; }
            .isl-detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: 2.25rem; align-items: start; }
            @media (max-width: 900px) { .isl-detail-grid { grid-template-columns: 1fr; } }

            /* section / panel */
            .isl-panel { background: rgba(24,24,27,0.65); border: 1px solid rgba(39,39,42,0.75); border-radius: 0.9rem; overflow: hidden; }
            .isl-panel-head { padding: 1.1rem 1.4rem; border-bottom: 1px solid rgba(39,39,42,0.75); display: flex; align-items: center; gap: 0.6rem; }
            .isl-panel-head h2 { font-family: var(--font-display); font-size: 1rem; font-weight: 700; letter-spacing: 0.01em; color: rgb(var(--ink)); margin: 0; }
            .isl-panel-head .bi { color: rgb(var(--ember-hi)); }
            .isl-panel-body { padding: 1.1rem 1.4rem 1.4rem; }

            /* course description prose */
            .isl-prose { color: rgb(var(--ink-dim)); font-size: 0.92rem; line-height: 1.7; }
            .isl-prose h1, .isl-prose h2, .isl-prose h3, .isl-prose h4 { font-family: var(--font-display); color: rgb(var(--ink)); margin: 1.2rem 0 0.5rem; line-height: 1.3; }
            .isl-prose p { margin: 0 0 0.85rem; }
            .isl-prose a { color: rgb(var(--ember-hi)); }
            .isl-prose ul, .isl-prose ol { margin: 0 0 0.85rem; padding-left: 1.3rem; }
            .isl-prose code { background: rgb(var(--bg)); border: 1px solid rgba(39,39,42,0.9); border-radius: 4px; padding: 0.1rem 0.35rem; font-size: 0.85em; }

            /* accordion (native details/summary — no JS dependency) */
            .isl-acc { display: flex; flex-direction: column; gap: 0.7rem; }
            .isl-sec { border: 1px solid rgba(39,39,42,0.85); border-radius: 0.7rem; overflow: hidden; background: rgba(9,9,11,0.4); }
            .isl-sec > summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 0.7rem;
                padding: 0.95rem 1.15rem; font-family: var(--font-display); font-weight: 700; font-size: 0.92rem; color: rgb(var(--ink));
                transition: background 0.2s ease; }
            .isl-sec > summary::-webkit-details-marker { display: none; }
            .isl-sec > summary:hover { background: rgba(39,39,42,0.4); }
            .isl-sec > summary .chev { margin-left: auto; color: rgb(var(--ink-faint)); transition: transform 0.2s ease; }
            .isl-sec[open] > summary .chev { transform: rotate(90deg); }
            .isl-sec > summary .fold-ico { color: rgb(var(--ember-hi)); }
            .isl-sec-inner { padding: 0.3rem 1.15rem 1.05rem; border-top: 1px solid rgba(39,39,42,0.6); }
            .isl-sec-desc { color: rgb(var(--ink-faint)); font-size: 0.82rem; margin: 0.75rem 0 0.6rem; }
            .isl-res { display: flex; align-items: center; gap: 0.6rem; padding: 0.6rem 0; border-bottom: 1px solid rgba(39,39,42,0.5); font-size: 0.87rem; }
            .isl-res:last-child { border-bottom: 0; }
            .isl-res .bi { color: rgb(var(--ember-hi)); }
            .isl-res.locked .bi, .isl-res.locked .name { color: rgb(var(--ink-faint)); }
            .isl-res .name { flex: 1; min-width: 0; color: rgb(var(--ink)); }
            .isl-res a.name:hover { color: rgb(var(--ember-hi)); }
            .isl-badge { font-family: var(--font-display); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
                border-radius: 999px; padding: 0.18rem 0.55rem; white-space: nowrap; }
            .isl-badge.preview { color: rgb(var(--ember-hi)); border: 1px solid rgba(249,115,22,0.35); }
            .isl-badge.locked { color: rgb(var(--ink-faint)); border: 1px solid rgba(113,113,122,0.4); }

            /* sidebar card */
            .isl-side { display: flex; flex-direction: column; gap: 1.4rem; position: sticky; top: 5.5rem; }
            @media (max-width: 900px) { .isl-side { position: static; } }
            .isl-card { border-radius: 0.9rem; overflow: hidden; background: rgba(24,24,27,0.65); border: 1px solid rgba(39,39,42,0.75); }
            .isl-card-cover { aspect-ratio: 16 / 9; width: 100%; object-fit: cover; background: #141010; border-bottom: 1px solid rgba(39,39,42,0.6); }
            .isl-card-cover--ph { display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #1f1a17, #141010); }
            .isl-card-cover--ph img { width: 46px; height: 46px; opacity: 0.9; }
            .isl-card-body { padding: 1.3rem 1.3rem 1.5rem; }
            .isl-meta { list-style: none; margin: 0 0 1.3rem; padding: 0; display: flex; flex-direction: column; gap: 0.7rem; }
            .isl-meta li { display: flex; align-items: baseline; gap: 0.55rem; font-size: 0.85rem; color: rgb(var(--ink-dim)); }
            .isl-meta .bi { color: rgb(var(--ember-hi)); font-size: 0.85rem; position: relative; top: 1px; }
            .isl-meta .k { color: rgb(var(--ink-faint)); }
            .isl-meta .v { color: rgb(var(--ink)); font-weight: 600; margin-left: auto; text-align: right; }
            .isl-meta .v.free { color: rgb(var(--ember-hi)); font-family: var(--font-display); }
            .isl-cta-hint { font-size: 0.8rem; color: rgb(var(--ink-faint)); text-align: center; margin: 0 0 0.75rem; }
            .isl-enrolled { display: flex; align-items: center; justify-content: center; gap: 0.45rem; font-size: 0.82rem; font-weight: 600;
                color: rgb(var(--ember-hi)); border: 1px solid rgba(249,115,22,0.3); border-radius: 0.55rem; padding: 0.6rem; margin-bottom: 0.75rem; }
            .isl-cta-stack { display: flex; flex-direction: column; gap: 0.6rem; }

            /* downloads */
            .isl-dl { margin-top: 1.3rem; border-top: 1px solid rgba(39,39,42,0.75); padding-top: 1rem; }
            .isl-dl h3 { font-family: var(--font-display); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(var(--ink-faint)); margin: 0 0 0.7rem; }
            .isl-dl a { display: flex; align-items: center; gap: 0.55rem; padding: 0.5rem 0; font-size: 0.85rem; color: rgb(var(--ink-dim)); border-bottom: 1px solid rgba(39,39,42,0.5); }
            .isl-dl a:last-child { border-bottom: 0; }
            .isl-dl a:hover { color: rgb(var(--ember-hi)); }
            .isl-dl a .bi { color: rgb(var(--ember-hi)); }

            /* empty state */
            .isl-empty { text-align: center; padding: 3rem 1rem; border: 1px dashed rgba(249,115,22,0.28); border-radius: 1rem; background: rgba(24,24,27,0.4); }
            .isl-empty img { width: 48px; height: 48px; opacity: 0.9; margin-bottom: 1rem; }
            .isl-empty h3 { font-family: var(--font-display); font-size: 1.15rem; color: rgb(var(--ink)); margin: 0 0 0.5rem; }
            .isl-empty p { color: rgb(var(--ink-dim)); margin: 0 auto; max-width: 40ch; font-size: 0.9rem; }

            /* footer */
            .isl-footer { border-top: 1px solid rgba(39,39,42,0.6); background: rgb(var(--bg-body)); }
            .isl-footer .isl-wrap { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.9rem; padding: 2rem 2rem 2.5rem; }
            .isl-footer .fb { display: inline-flex; align-items: center; gap: 0.55rem; font-family: var(--font-display); font-weight: 700; color: rgb(var(--ink-dim)); }
            .isl-footer .fb img { width: 22px; height: 22px; object-fit: contain; }
            .isl-footer .fc { font-size: 0.75rem; letter-spacing: 0.04em; color: rgb(var(--ink-faint)); }
            .isl-footer .fc a { color: rgb(var(--ember-hi)); }

            @media (max-width: 640px) {
                .isl-wrap { padding: 0 1.25rem; }
                .isl-header .isl-wrap { padding: 0 1rem; height: 3.9rem; }
                .isl-brand .word { display: none; }
                .isl-nav-actions { gap: 0.5rem; }
                .isl-nav .isl-btn-sm { padding: 0.5rem 0.85rem; font-size: 0.78rem; }
            }
            @media (prefers-reduced-motion: reduce) { .isl-root * { transition: none !important; } }
        </style>
    </head>
    <body class="isl-root">
        <header class="isl-header">
            <div class="isl-wrap">
                <a class="isl-brand" href="/" aria-label="Intent Solutions Learn — home">
                    <img src="{{ S }}/logo-mark.png" alt="" width="30" height="30" />
                    <span class="word">Intent<span class="s">Solutions</span></span>
                </a>
                <nav class="isl-nav" aria-label="Primary">
                    <a class="link" href="{{ url_for('course.lista_cursos') }}">Courses</a>
                    <a class="link" href="/#team">Team</a>
                    <a class="link" href="https://intentsolutions.io" target="_blank" rel="noopener">About</a>
                    <span class="isl-nav-actions">
                        {% if current_user.is_authenticated %}
                        <a class="isl-btn isl-btn-secondary isl-btn-sm" href="{{ url_for('home.panel') }}">Dashboard</a>
                        {% else %}
                        <a class="isl-btn isl-btn-primary isl-btn-sm" href="{{ url_for('user.inicio_sesion') }}">Sign in</a>
                        {% endif %}
                    </span>
                </nav>
            </div>
        </header>

        <section class="isl-cat-head">
            <div class="glow" aria-hidden="true"></div>
            <div class="isl-wrap">
                <div class="isl-crumbs">
                    <a href="{{ url_for('course.lista_cursos') }}">Courses</a> &rsaquo; {{ curso.nombre }}
                </div>
                <div class="isl-eyebrow" aria-hidden="true"><span class="rule"></span><span class="label">{{ levels.get(curso.nivel, 'Course') }}</span></div>
                <h1>{{ curso.nombre }}</h1>
                {% if curso.descripcion_corta %}
                <p>{{ curso.descripcion_corta }}</p>
                {% endif %}
            </div>
        </section>

        <main class="isl-cat-body">
            <div class="isl-wrap">
                <div class="isl-detail-grid">
                    <!-- Main column: description + course content -->
                    <div>
                        {% if editable %}
                        <div style="margin-bottom: 1.4rem;">
                            <a class="isl-btn isl-btn-secondary isl-btn-sm" href="{{ url_for('course.administrar_curso', course_code=curso.codigo) }}">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i> Manage course
                            </a>
                        </div>
                        {% endif %}

                        {% if curso.descripcion %}
                        <section class="isl-panel" style="margin-bottom: 1.6rem;">
                            <div class="isl-panel-head"><i class="bi bi-info-circle" aria-hidden="true"></i><h2>About this course</h2></div>
                            <div class="isl-panel-body">
                                <div class="isl-prose">{{ markdown2html(curso.descripcion) | safe }}</div>
                            </div>
                        </section>
                        {% endif %}

                        <section class="isl-panel">
                            <div class="isl-panel-head">
                                <i class="bi bi-list-ul" aria-hidden="true"></i>
                                <h2>Course content</h2>
                            </div>
                            <div class="isl-panel-body">
                                {% if secciones %}
                                <div class="isl-acc">
                                    {% for seccion in secciones %}
                                    <details class="isl-sec"{% if loop.first %} open{% endif %}>
                                        <summary>
                                            <i class="bi bi-folder2-open fold-ico" aria-hidden="true"></i>
                                            <span>{{ seccion.nombre }}</span>
                                            <i class="bi bi-chevron-right chev" aria-hidden="true"></i>
                                        </summary>
                                        <div class="isl-sec-inner">
                                            {% if seccion.descripcion %}
                                            <p class="isl-sec-desc">{{ seccion.descripcion }}</p>
                                            {% endif %}
                                            {% for recurso in recursos %}{% if recurso.seccion == seccion.id %}
                                            {% if recurso.publico == True %}
                                            <div class="isl-res">
                                                <i class="{{ iconos_recursos[recurso.tipo] }}" aria-hidden="true"></i>
                                                <a class="name" href="{{ url_for('resources.pagina_recurso', curso_id=recurso.curso, codigo=recurso.id, resource_type=recurso.tipo) }}">{{ recurso.nombre }}</a>
                                                <span class="isl-badge preview"><i class="bi bi-eye-fill" aria-hidden="true"></i> Preview</span>
                                            </div>
                                            {% else %}
                                            <div class="isl-res locked">
                                                <i class="{{ iconos_recursos[recurso.tipo] }}" aria-hidden="true"></i>
                                                <span class="name">{{ recurso.nombre }}</span>
                                                <span class="isl-badge locked"><i class="bi bi-lock-fill" aria-hidden="true"></i> Restricted</span>
                                            </div>
                                            {% endif %}
                                            {% endif %}{% endfor %}
                                        </div>
                                    </details>
                                    {% endfor %}
                                </div>
                                {% else %}
                                <div class="isl-empty">
                                    <img src="{{ S }}/logo-mark.png" alt="" />
                                    <h3>No content yet</h3>
                                    <p>This course doesn't have any sections available right now. Check back soon.</p>
                                </div>
                                {% endif %}
                            </div>
                        </section>
                    </div>

                    <!-- Sidebar: cover, honest metadata, single CTA -->
                    <aside class="isl-side">
                        <div class="isl-card">
                            {% if curso.portada and course_logo(curso.codigo) %}
                            <img class="isl-card-cover" src="{{ url_for('static', filename='/files/public/images/' + curso.codigo + '/' + course_logo(curso.codigo)) }}" alt="{{ curso.nombre }}" />
                            {% else %}
                            <span class="isl-card-cover isl-card-cover--ph" aria-hidden="true"><img src="{{ S }}/logo-mark.png" alt="" /></span>
                            {% endif %}
                            <div class="isl-card-body">
                                <ul class="isl-meta">
                                    <li>
                                        <i class="bi bi-bar-chart-fill" aria-hidden="true"></i>
                                        <span class="k">Level</span>
                                        <span class="v">{{ levels.get(curso.nivel, 'Course') }}</span>
                                    </li>
                                    <li>
                                        <i class="bi bi-collection-fill" aria-hidden="true"></i>
                                        <span class="k">Sections</span>
                                        <span class="v">{{ secciones | length }}</span>
                                    </li>
                                    <li>
                                        <i class="bi bi-play-circle-fill" aria-hidden="true"></i>
                                        <span class="k">Lessons</span>
                                        <span class="v">{{ recursos | length }}</span>
                                    </li>
                                    {% if curso.modalidad in ('time_based', 'live') and curso.fecha_inicio and curso.fecha_fin %}
                                    <li>
                                        <i class="bi bi-calendar-week" aria-hidden="true"></i>
                                        <span class="k">Dates</span>
                                        <span class="v">{{ curso.fecha_inicio }} – {{ curso.fecha_fin }}</span>
                                    </li>
                                    {% else %}
                                    <li>
                                        <i class="bi bi-clock-fill" aria-hidden="true"></i>
                                        <span class="k">Format</span>
                                        <span class="v">Self-paced</span>
                                    </li>
                                    {% endif %}
                                    <li>
                                        <i class="bi bi-tag-fill" aria-hidden="true"></i>
                                        <span class="k">Price</span>
                                        {% if curso.pagado and curso.precio %}
                                        <span class="v">{{ curso.precio | float }} {{ site_config.moneda }}</span>
                                        {% else %}
                                        <span class="v free">Free</span>
                                        {% endif %}
                                    </li>
                                    {% if curso.certificado %}
                                    <li>
                                        <i class="bi bi-award-fill" aria-hidden="true"></i>
                                        <span class="k">Certificate</span>
                                        <span class="v">On completion</span>
                                    </li>
                                    {% endif %}
                                </ul>

                                <!-- Single, honest CTA (stock logic, reskinned) -->
                                {% if current_user.is_authenticated %}
                                    {% if current_user.tipo == "student" %}
                                        {% if estudiante_asignado(curso.codigo) %}
                                        <div class="isl-enrolled"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> You're enrolled</div>
                                        <div class="isl-cta-stack">
                                            <a class="isl-btn isl-btn-primary isl-btn-block" href="{{ url_for('course.tomar_curso', course_code=curso.codigo) }}">
                                                <i class="bi bi-play-fill" aria-hidden="true"></i> Continue course
                                            </a>
                                        </div>
                                        {% else %}
                                        <div class="isl-cta-stack">
                                            <a class="isl-btn isl-btn-primary isl-btn-block" href="{{ url_for('course.course_enroll', course_code=curso.codigo) }}">
                                                <i class="bi bi-backpack-fill" aria-hidden="true"></i> Enroll
                                            </a>
                                        </div>
                                        {% endif %}
                                    {% else %}
                                    <div class="isl-cta-stack">
                                        <a class="isl-btn isl-btn-secondary isl-btn-block" href="{{ url_for('home.panel') }}">
                                            <i class="bi bi-speedometer2" aria-hidden="true"></i> Go to dashboard
                                        </a>
                                    </div>
                                    {% endif %}
                                {% else %}
                                <p class="isl-cta-hint">Create a free account to start this course.</p>
                                <div class="isl-cta-stack">
                                    <a class="isl-btn isl-btn-primary isl-btn-block" href="{{ url_for('user.crear_cuenta') }}">
                                        <i class="bi bi-person-plus-fill" aria-hidden="true"></i> Create free account
                                    </a>
                                    <a class="isl-btn isl-btn-secondary isl-btn-block" href="{{ url_for('user.inicio_sesion') }}">
                                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in
                                    </a>
                                </div>
                                {% endif %}

                                <!-- Downloadable resources -->
                                {% if descargas %}
                                <div class="isl-dl">
                                    <h3>Downloads</h3>
                                    {% for item in descargas %}
                                    <a href="{{ url_for('resource.vista_recurso', resource_code=item.codigo) }}">
                                        <i class="{{ iconos_recursos[item.tipo] }}" aria-hidden="true"></i>
                                        <span>{{ item.nombre }}</span>
                                    </a>
                                    {% endfor %}
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </aside>
                </div>
            </div>
        </main>

        <footer class="isl-footer">

<!doctype html>
<html lang="en">
    {% from 'macros/blog_section.j2' import render_blog_section %} {% set current_theme = current_theme() %}{% set
    site_config = config() %}
    <head>
        {{ current_theme.headertags() }} {{ current_theme.local_style() }}
        <title>{{ site_config.titulo_html or "Intent Solutions Learn" }}</title>

        <style>
            /* ============================================================
       Intent Solutions Learn — front door
       TRANSFERRED FROM MAX'S HUB THEME (learn-intent-solutions-hub/
       public/theme.css). Tokens + primitives are his, verbatim:
       #18171b warm near-black ground, #f97316 orange, elevated-DARKER
       cards, Syne display / Inter body / JetBrains Mono labels, his
       logo-badge glyph, header-glow, orange-glow CTA. Only the page
       composition here is new; the design language is Max's.
       ============================================================ */
            :root {
                --bg: #18171b;
                --bg-elevated: #131217;
                --bg-inset: #201f24;
                --bg-inset-2: #29282e;
                --ink: #f5f4f2;
                --ink-dim: #a5a3a0;
                --ink-faint: #85837f;
                --accent: #f97316;
                --accent-bright: #fb923c;
                --accent-press: #ea6a0e;
                --accent-ink: #18171b;
                --accent-wash: rgba(249, 115, 22, 0.11);
                --accent-line: rgba(249, 115, 22, 0.32);
                --accent-line-hi: rgba(249, 115, 22, 0.55);
                --accent-ring: 0 0 0 3px rgba(249, 115, 22, 0.35);
                --accent-glow: 0 4px 14px -4px rgba(249, 115, 22, 0.5);
                --accent-glow-hi: 0 6px 20px -4px rgba(249, 115, 22, 0.65);
                --line: rgba(245, 244, 242, 0.11);
                --line-soft: rgba(245, 244, 242, 0.06);
                --positive: #4ade80;
                --shadow:
                    0 2px 4px rgba(0, 0, 0, 0.3),
                    0 16px 40px -20px rgba(0, 0, 0, 0.7);
                --shadow-hover:
                    0 4px 10px rgba(0, 0, 0, 0.35),
                    0 20px 50px -20px rgba(0, 0, 0, 0.8);
                --ease: cubic-bezier(0.32, 0.72, 0, 1);
                --font-display: "Syne", "Inter", system-ui, sans-serif;
                --font-ui:
                    "Inter",
                    -apple-system,
                    BlinkMacSystemFont,
                    "Segoe UI",
                    system-ui,
                    sans-serif;
                --font-mono:
                    "JetBrains Mono",
                    ui-monospace,
                    SFMono-Regular,
                    Menlo,
                    monospace;
                --maxw: 1200px;
            }
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            html {
                scroll-behavior: smooth;
            }
            body {
                background: var(--bg);
                color: var(--ink);
                font-family: var(--font-ui);
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
                overflow-x: hidden;
            }
            a {
                color: inherit;
                text-decoration: none;
            }
            h1,
            h2,
            h3 {
                font-family: var(--font-display);
                font-weight: 700;
                letter-spacing: -0.01em;
                text-wrap: balance;
            }
            .num {
                font-family: var(--font-ui);
                font-weight: 800;
                font-variant-numeric: tabular-nums;
            }
            :focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 2px;
            }
            .wrap {
                max-width: var(--maxw);
                margin: 0 auto;
                padding: 0 28px;
            }
            .mono {
                font-family: var(--font-mono);
            }

            /* header — his chrome */
            header.top {
                position: sticky;
                top: 0;
                z-index: 20;
                overflow: hidden;
                background: color-mix(in srgb, var(--bg) 88%, transparent);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid var(--line);
            }
            .header-glow {
                position: absolute;
                top: -140px;
                left: 60px;
                width: 340px;
                height: 220px;
                background: radial-gradient(ellipse at center, rgba(249, 115, 22, 0.16), transparent 70%);
                pointer-events: none;
                filter: blur(8px);
            }
            .top .wrap {
                position: relative;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                height: 66px;
            }
            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
            }
            .logo-badge {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                background: var(--accent);
                display: grid;
                place-items: center;
                flex-shrink: 0;
                box-shadow:
                    0 0 0 1px rgba(249, 115, 22, 0.4),
                    0 4px 14px -4px rgba(249, 115, 22, 0.55);
            }
            .logo-badge svg {
                width: 17px;
                height: 17px;
            }
            .brand .name {
                font-weight: 700;
                font-size: 15px;
                letter-spacing: -0.005em;
                color: var(--ink-dim);
            }
            .brand .name .sep {
                color: var(--line);
            }
            .brand .name .here {
                color: var(--ink);
                font-weight: 600;
            }
            nav.crumbs {
                display: flex;
                gap: 24px;
                font-size: 13.5px;
                color: var(--ink-faint);
            }
            nav.crumbs a {
                padding: 4px 0;
                border-bottom: 2px solid transparent;
                transition:
                    color 160ms var(--ease),
                    border-color 160ms var(--ease);
            }
            nav.crumbs a:hover {
                color: var(--ink);
            }
            @media (max-width: 760px) {
                nav.crumbs {
                    display: none;
                }
                .brand .name .sub-hide {
                    display: none;
                }
            }

            /* buttons — his primitives */
            .cta {
                display: inline-flex;
                align-items: center;
                gap: 9px;
                background: var(--accent);
                color: var(--accent-ink);
                border: 0;
                font: inherit;
                font-weight: 700;
                cursor: pointer;
                text-decoration: none;
                padding: 11px 20px;
                border-radius: 999px;
                box-shadow: var(--accent-glow);
                transition:
                    background 160ms var(--ease),
                    transform 160ms var(--ease),
                    box-shadow 160ms var(--ease);
            }
            .cta:hover {
                background: var(--accent-bright);
                box-shadow: var(--accent-glow-hi);
                transform: translateY(-2px);
            }
            .cta:active {
                background: var(--accent-press);
                transform: none;
            }
            .btn-ghost {
                display: inline-flex;
                align-items: center;
                gap: 9px;
                background: var(--bg-inset);
                color: var(--ink);
                border: 1px solid var(--line);
                font: inherit;
                font-weight: 700;
                cursor: pointer;
                padding: 11px 20px;
                border-radius: 999px;
                transition:
                    border-color 160ms var(--ease),
                    color 160ms var(--ease),
                    background 160ms var(--ease);
            }
            .btn-ghost:hover {
                border-color: var(--accent);
                color: var(--accent);
                background: var(--accent-wash);
            }
            .btn-sm {
                padding: 9px 16px;
                font-size: 13px;
            }

            /* labels */
            .eyebrow {
                font-family: var(--font-mono);
                font-size: 11.5px;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                color: var(--accent);
                display: inline-flex;
                align-items: center;
                gap: 9px;
            }
            .sec-label {
                font-family: var(--font-mono);
                font-size: 11px;
                letter-spacing: 0.15em;
                text-transform: uppercase;
                color: var(--ink-faint);
            }

            /* entrance — his rise */
            @keyframes rise {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }
                to {
                    opacity: 1;
                    transform: none;
                }
            }
            .rise {
                animation: rise 640ms var(--ease) both;
            }
            .d1 {
                animation-delay: 60ms;
            }
            .d2 {
                animation-delay: 140ms;
            }
            .d3 {
                animation-delay: 220ms;
            }
            .d4 {
                animation-delay: 300ms;
            }
            @media (prefers-reduced-motion: reduce) {
                .rise {
                    animation: none;
                }
                * {
                    scroll-behavior: auto;
                }
            }

            /* hero */
            .hero {
                position: relative;
                padding: 104px 0 84px;
                overflow: hidden;
            }
            .hero .header-glow {
                top: -60px;
                left: auto;
                right: 8%;
                width: 520px;
                height: 360px;
                opacity: 0.9;
            }
            .hero .wrap {
                position: relative;
                z-index: 1;
            }
            .hero h1 {
                font-size: clamp(2.5rem, 6vw, 4.3rem);
                line-height: 1.03;
                letter-spacing: -0.03em;
                max-width: 16ch;
                margin: 26px 0 22px;
            }
            .hero .lede {
                font-size: clamp(1.05rem, 1.7vw, 1.26rem);
                color: var(--ink-dim);
                max-width: 56ch;
            }
            .hero .lede b {
                color: var(--ink);
                font-weight: 600;
            }
            .cta-row {
                display: flex;
                gap: 13px;
                flex-wrap: wrap;
                margin-top: 38px;
            }

            /* proof strip */
            .proof {
                border-top: 1px solid var(--line);
                border-bottom: 1px solid var(--line);
                background: var(--bg-elevated);
            }
            .proof .wrap {
                display: flex;
                flex-wrap: wrap;
                padding: 26px 28px;
                gap: 20px 0;
            }
            .stat {
                flex: 1;
                min-width: 150px;
                display: flex;
                flex-direction: column;
                gap: 4px;
            }
            .stat + .stat {
                border-left: 1px solid var(--line);
                padding-left: 26px;
                margin-left: 26px;
            }
            .stat .n {
                font-family: var(--font-ui);
                font-weight: 800;
                font-variant-numeric: tabular-nums;
                font-size: 1.8rem;
                letter-spacing: -0.02em;
                color: var(--ink);
            }
            .stat .l {
                font-family: var(--font-mono);
                font-size: 10.5px;
                letter-spacing: 0.13em;
                text-transform: uppercase;
                color: var(--ink-faint);
            }
            @media (max-width: 760px) {
                .stat + .stat {
                    border-left: 0;
                    padding-left: 0;
                    margin-left: 0;
                }
                .proof .wrap {
                    gap: 22px 32px;
                }
            }

            section.band {
                padding: 92px 0;
            }
            .band-head .eyebrow {
                margin-bottom: 16px;
            }
            .band-head h2 {
                font-size: clamp(1.8rem, 3.4vw, 2.5rem);
                letter-spacing: -0.025em;
                max-width: 20ch;
            }
            .band-head p {
                color: var(--ink-dim);
                max-width: 56ch;
                margin-top: 14px;
                font-size: 1.04rem;
            }

            /* cards — his card primitive */
            .grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 16px;
                margin-top: 48px;
            }
            @media (max-width: 900px) {
                .grid {
                    grid-template-columns: 1fr 1fr;
                }
            }
            @media (max-width: 600px) {
                .grid {
                    grid-template-columns: 1fr;
                }
            }
            .card {
                background: var(--bg-elevated);
                border: 1px solid var(--line);
                border-radius: 16px;
                box-shadow: var(--shadow);
                padding: 24px 22px 26px;
                position: relative;
                overflow: hidden;
                transition:
                    border-color 200ms var(--ease),
                    transform 200ms var(--ease),
                    box-shadow 200ms var(--ease);
            }
            .card:hover {
                border-color: var(--accent-line);
                transform: translateY(-3px);
                box-shadow: var(--shadow-hover);
            }
            .card .k {
                font-family: var(--font-mono);
                font-size: 10px;
                letter-spacing: 0.1em;
                color: var(--accent);
                border: 1px solid var(--accent-line);
                border-radius: 999px;
                padding: 3px 9px;
                display: inline-block;
            }
            .card h3 {
                font-size: 1.2rem;
                margin: 15px 0 9px;
            }
            .card p {
                color: var(--ink-dim);
                font-size: 0.95rem;
                line-height: 1.6;
            }
            .card ul {
                list-style: none;
                margin-top: 15px;
                display: grid;
                gap: 8px;
            }
            .card li {
                font-size: 0.88rem;
                color: var(--ink-dim);
                line-height: 1.5;
                padding-left: 16px;
                position: relative;
            }
            .card li::before {
                content: "—";
                position: absolute;
                left: 0;
                color: var(--accent);
            }

            /* teaching */
            .people {
                background: var(--bg-elevated);
                border-top: 1px solid var(--line);
                border-bottom: 1px solid var(--line);
            }
            .people-grid {
                display: grid;
                grid-template-columns: 1.05fr 1fr;
                gap: 52px;
                align-items: center;
            }
            @media (max-width: 820px) {
                .people-grid {
                    grid-template-columns: 1fr;
                    gap: 34px;
                }
            }
            .person {
                display: flex;
                gap: 16px;
                align-items: flex-start;
                padding: 20px 0;
            }
            .person + .person {
                border-top: 1px solid var(--line-soft);
            }
            .avatar {
                width: 52px;
                height: 52px;
                flex: none;
                border-radius: 999px;
                display: grid;
                place-items: center;
                font-family: var(--font-mono);
                font-size: 15px;
                font-weight: 700;
            }
            .avatar.brand {
                background: var(--accent);
                color: var(--accent-ink);
            }
            .avatar.plain {
                background: var(--bg-inset);
                color: var(--ink-dim);
                border: 1px solid var(--line);
            }
            .person .role {
                font-family: var(--font-mono);
                font-size: 10.5px;
                letter-spacing: 0.13em;
                text-transform: uppercase;
                color: var(--accent);
                margin-bottom: 5px;
            }
            .person .nm {
                font-size: 1.14rem;
                font-weight: 700;
                font-family: var(--font-display);
                letter-spacing: -0.01em;
            }
            .person .bio {
                color: var(--ink-dim);
                font-size: 0.93rem;
                margin-top: 6px;
                max-width: 42ch;
            }

            /* final */
            .final {
                padding: 98px 0;
                text-align: center;
                position: relative;
                overflow: hidden;
            }
            .final .header-glow {
                top: auto;
                bottom: -160px;
                left: 50%;
                transform: translateX(-50%);
                width: 640px;
                height: 360px;
                opacity: 0.8;
            }
            .final .wrap {
                position: relative;
            }
            .final h2 {
                font-size: clamp(2rem, 4vw, 3rem);
                letter-spacing: -0.03em;
                max-width: 18ch;
                margin: 0 auto 16px;
            }
            .final p {
                color: var(--ink-dim);
                max-width: 46ch;
                margin: 0 auto 32px;
                font-size: 1.06rem;
            }
            .final .cta-row {
                justify-content: center;
            }

            footer.foot {
                border-top: 1px solid var(--line);
                padding: 30px 28px 42px;
                display: flex;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 12px;
                align-items: center;
            }
            footer.foot .f-brand {
                display: flex;
                align-items: center;
                gap: 9px;
                color: var(--ink-dim);
                font-weight: 700;
                font-size: 14px;
            }
            footer.foot .f-credit {
                font-family: var(--font-mono);
                font-size: 11px;
                letter-spacing: 0.06em;
                color: var(--ink-faint);
            }
        </style>
    </head>
    <body>
        <!-- Intent Solutions mark, reused verbatim from public/favicon.svg -->
        <header class="top">
            <div class="header-glow" aria-hidden="true"></div>
            <div class="wrap">
                <a class="brand" href="#top">
                    <span class="logo-badge" aria-hidden="true">
                        <svg viewBox="0 0 128 128" fill="none">
                            <path
                                fill="var(--bg)"
                                d="M50.4 78.5a75.1 75.1 0 0 0-28.5 6.9l24.2-65.7c.7-2 1.9-3.2 3.4-3.2h29c1.5 0 2.7 1.2 3.4 3.2l24.2 65.7s-11.6-7-28.5-7L67 45.5c-.4-1.7-1.6-2.8-2.9-2.8-1.3 0-2.5 1.1-2.9 2.7L50.4 78.5Zm-1.1 28.2Zm-4.2-20.2c-2 6.6-.6 15.8 4.2 20.2a17.5 17.5 0 0 1 .2-.7 5.5 5.5 0 0 1 5.7-4.5c2.8.1 4.3 1.5 4.7 4.7.2 1.1.2 2.3.2 3.5v.4c0 2.7.7 5.2 2.2 7.4a13 13 0 0 0 5.7 4.9v-.3l-.2-.3c-1.8-5.6-.5-9.5 4.4-12.8l1.5-1a73 73 0 0 0 3.2-2.2 16 16 0 0 0 6.8-11.4c.3-2 .1-4-.6-6l-.8.6-1.6 1a37 37 0 0 1-22.4 2.7c-5-.7-9.7-2-13.2-6.2Z"
                            />
                        </svg>
                    </span>
                    <span class="name">Intent&nbsp;Solutions <span class="sep">/</span> <span class="here">Learn</span></span>
                </a>
                <nav class="crumbs" aria-label="Primary">
                    <a href="#curriculum">Curriculum</a>
                    <a href="#teaching">Who teaches</a>
                    <a href="#why">Why us</a>
                    {% if current_user.is_authenticated %}
                    <a href="{{ url_for('home.panel') }}">Dashboard</a>
                    {% else %}
                    <a href="{{ url_for('user.inicio_sesion') }}">Sign in</a>
                    {% endif %}
                </nav>
                {% if current_user.is_authenticated %}
                <a class="cta btn-sm" href="{{ url_for('home.panel') }}">Go to dashboard →</a>
                {% else %}
                <a class="cta btn-sm" href="{{ url_for('course.lista_cursos', page=1) }}">Start learning →</a>
                {% endif %}
            </div>
        </header>

        <main id="top">
            <section class="hero">
                <div class="header-glow" aria-hidden="true"></div>
                <div class="wrap">
                    <span class="eyebrow rise d1">Intent Solutions Learn</span>
                    <h1 class="rise d2">Learn to build AI-native software the way we ship it.</h1>
                    <p class="lede rise d3">
                        Practitioner training from the team behind open-source developer tooling used by thousands of
                        engineers. <b>No theory for theory's sake</b> — you learn the exact workflows, patterns, and
                        guardrails we use to put real systems into production.
                    </p>
                    <div class="cta-row rise d4">
                        <a class="cta" href="#curriculum">Browse the curriculum →</a>
                        {% if current_user.is_authenticated %}
                        <a class="btn-ghost" href="{{ url_for('home.panel') }}">Go to dashboard</a>
                        {% else %}
                        <a class="btn-ghost" href="{{ url_for('user.inicio_sesion') }}">Sign in</a>
                        {% endif %}
                    </div>
                </div>
            </section>

            <div class="proof" id="why">
                <div class="wrap">
                    <div class="stat"><span class="n">2,500+</span><span class="l">GitHub stars</span></div>
                    <div class="stat"><span class="n">300+</span><span class="l">Forks</span></div>
                    <div class="stat"><span class="n">45k+</span><span class="l">npm installs</span></div>
                    <div class="stat"><span class="n">In prod</span><span class="l">Not a sandbox</span></div>
                </div>
            </div>

            <section class="band" id="curriculum">
                <div class="wrap">
                    <div class="band-head">
                        <span class="eyebrow">The curriculum</span>
                        <h2>From first principles to shipping in production.</h2>
                        <p>
                            Every track is hands-on and built from real work — the same tooling and decisions that produced
                            our open-source platform.
                        </p>
                    </div>
                    <div class="grid">
                        <article class="card">
                            <span class="k">TRACK 01</span>
                            <h3>AI-native foundations</h3>
                            <p>
                                How to think, prompt, and structure work when an agent is in the loop — the mental model
                                before the tools.
                            </p>
                            <ul>
                                <li>Agentic workflow design</li>
                                <li>Context &amp; memory patterns</li>
                                <li>When not to use AI</li>
                            </ul>
                        </article>
                        <article class="card">
                            <span class="k">TRACK 02</span>
                            <h3>Building &amp; extending</h3>
                            <p>Build and ship real tooling — plugins, skills, and agents — end to end.</p>
                            <ul>
                                <li>Authoring skills &amp; plugins</li>
                                <li>Multi-agent orchestration</li>
                                <li>Testing what agents write</li>
                            </ul>
                        </article>
                        <article class="card">
                            <span class="k">TRACK 03</span>
                            <h3>Shipping to production</h3>
                            <p>
                                The part tutorials skip: deploys, rollbacks, secrets, and monitoring for systems with AI
                                inside them.
                            </p>
                            <ul>
                                <li>Deploy &amp; auto-rollback</li>
                                <li>Secrets &amp; supply chain</li>
                                <li>Observability for agents</li>
                            </ul>
                        </article>
                        <article class="card">
                            <span class="k">TRACK 04</span>
                            <h3>Evaluation &amp; governance</h3>
                            <p>
                                Prove it works and keep it honest — evals, guardrails, and the receipts that make AI output
                                trustworthy.
                            </p>
                            <ul>
                                <li>Building real evals</li>
                                <li>Guardrails &amp; policy</li>
                                <li>Audit &amp; provenance</li>
                            </ul>
                        </article>
                        <article class="card">
                            <span class="k">TRACK 05</span>
                            <h3>Practice &amp; assessment</h3>
                            <p>
                                Scored practice, real projects, and feedback — prove your skills on work that resembles the
                                job.
                            </p>
                            <ul>
                                <li>Scored practice sets</li>
                                <li>Project-based review</li>
                                <li>A portfolio you keep</li>
                            </ul>
                        </article>
                        <article class="card">
                            <span class="k">TRACK 06</span>
                            <h3>Community &amp; support</h3>
                            <p>
                                Learn alongside other builders, get unblocked fast, and ship together — the part that keeps
                                you going.
                            </p>
                            <ul>
                                <li>Live working sessions</li>
                                <li>Peer &amp; mentor review</li>
                                <li>A room full of builders</li>
                            </ul>
                        </article>
                    </div>
                </div>
            </section>

            <section class="people band" id="teaching">
                <div class="wrap">
                    <div class="people-grid">
                        <div class="band-head">
                            <span class="eyebrow">Who teaches</span>
